# ==========================================================================
# DEMİRCE — Apache yapılandırması (cPanel / paylaşımlı hosting)
# Bu dosya derleme sırasında dist/ klasörüne kopyalanır.
# ==========================================================================
Options -MultiViews -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS'e yönlendir (proxy / CDN arkasında da çalışır)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # demirce.com → www.demirce.com
  RewriteCond %{HTTP_HOST} ^demirce\.com$ [NC]
  RewriteRule ^ https://www.demirce.com%{REQUEST_URI} [L,R=301]
</IfModule>

# --------------------------------------------------------------------------
# Eski WordPress adreslerinden yeni adreslere kalıcı (301) yönlendirmeler
# (arama motoru sıralamalarını ve eski bağlantıları korur)
