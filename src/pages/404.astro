---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
---

<Base lang="tr" title="Sayfa bulunamadı" sheet="A-404" noindex>
  <section class="wrap nf">
    <div class="sheet crop" aria-hidden="true">
      <span class="display code">404</span>
      <svg viewBox="0 0 200 120" class="dim">
        <path d="M10 100 H190 M10 95 V105 M190 95 V105" stroke="currentColor" fill="none" />
        <text x="100" y="92" text-anchor="middle" font-family="monospace" font-size="9" fill="currentColor">? m</text>
        <rect x="40" y="20" width="120" height="60" fill="none" stroke="currentColor" stroke-dasharray="4 4" />
      </svg>
    </div>
    <div>
      <p class="label muted"><span class="accent">A-404 — </span>Pafta bulunamadı · Sheet not found</p>
      <h1 class="display">Bu pafta henüz çizilmedi.</h1>
      <p class="lead">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Eski sitemizdeki bağlantılar yeni adreslerine yönlendirilir.</p>
      <p class="mono muted">This sheet hasn’t been drawn yet. The page may have moved.</p>
      <div class="actions">
        <a class="btn" href="/">Ana sayfa <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/projeler/">Projeler</a>
        <a class="btn btn--ghost" href="/en/">English</a>
        <button type="button" class="btn btn--ghost" data-open-palette><Icon name="search" size={16} />Ara</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-block: clamp(64px, 10vw, 160px);
  }
  .sheet {
    border: 1px solid var(--line-strong);
    padding: 24px;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 24px 24px;
  }
  .code {
    display: block;
    font-size: clamp(6rem, 20vw, 16rem);
    color: var(--accent-text);
  }
  .dim {
    color: var(--ink-3);
  }
  h1 {
    font-size: var(--step-4);
    margin: 18px 0 20px;
    text-transform: uppercase;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  @media (max-width: 800px) {
    .nf {
      grid-template-columns: 1fr;
    }
  }
</style>
