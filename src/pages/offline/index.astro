---
import Base from '~/layouts/Base.astro';
---

<Base lang="tr" title="Çevrimdışı" sheet="A-00" noindex>
  <section class="wrap" style="padding-block: clamp(64px, 10vw, 160px)">
    <p class="label muted"><span class="accent">— </span>Offline</p>
    <h1 class="display" style="font-size: var(--step-5); margin: 18px 0 24px">Çevrimdışısınız</h1>
    <p class="lead">İnternet bağlantınız yok gibi görünüyor. Daha önce ziyaret ettiğiniz sayfalar çevrimdışı da açılabilir.</p>
    <p class="mono muted">You appear to be offline. Pages you have visited before are still available.</p>
    <p><a class="btn" href="/">Ana sayfa</a></p>
  </section>
</Base>
