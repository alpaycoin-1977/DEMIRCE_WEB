---
import Case from '~/views/Case.astro';
import Plate from '~/views/Plate.astro';
import { getCase, type Case as CaseT } from '~/data/cases';
import { projects, type Project } from '~/data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project, cs: getCase(project.slug) } }));
}
const { project, cs } = Astro.props as { project: Project; cs?: CaseT };
---

{cs ? <Case cs={cs} lang="tr" /> : <Plate project={project} lang="tr" />}
