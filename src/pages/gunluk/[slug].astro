---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostPage from '~/views/PostPage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('journal', (e) => e.id.startsWith('tr/') && !e.data.draft);
  return posts.map((post) => ({ params: { slug: post.id.split('/')[1] }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'journal'> };
---

<PostPage post={post} lang="tr" />
