---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Book from '~/layouts/Book.astro';
import { getProject } from '~/data/projects';
import { u, postUrl, projectUrl, formatDate, type Lang } from '~/i18n/ui';

interface Props {
  post: CollectionEntry<'journal'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const slug = post.id.split('/')[1];
const { Content } = await render(post);
const project = post.data.project ? getProject(post.data.project) : undefined;
---

<Book
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternates={{ tr: postUrl(slug, 'tr'), en: postUrl(slug, 'en') }}
  image={post.data.cover}
  type="article"
  running={lang === 'tr' ? 'Notlar' : 'Notes'}
>
  <article class="wrap post">
    <header class="head">
      <a class="small muted back" href={u(lang === 'tr' ? '/gunluk/' : '/en/journal/')}>← {lang === 'tr' ? 'Notlar' : 'Notes'}</a>
      <time class="small muted" datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </header>
    {
      post.data.cover && (
        <figure class="cover">
          <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[640, 960, 1400]} sizes="(min-width: 1100px) 1000px, 100vw" loading="eager" />
          {post.data.coverAlt && <figcaption>{post.data.coverAlt}</figcaption>}
        </figure>
      )
    }
    <div class="prose body"><Content /></div>
    {
      project && (
        <p class="rel">
          <a class="arrow-link" href={projectUrl(project.slug, lang)}>
            {project.title[lang]}
          </a>
        </p>
      )
    }
  </article>
</Book>

<style>
  .post {
    max-width: 980px;
  }
  .head {
    display: grid;
    gap: 10px;
    padding-block: clamp(48px, 8vw, 120px) clamp(32px, 4vw, 48px);
  }
  .back {
    text-decoration: none;
  }
  h1 {
    font-size: var(--t-xxl);
    margin-block: 8px;
  }
  .lead {
    font-size: var(--t-l);
    color: var(--ink-2);
    margin: 0;
  }
  .cover :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    background: var(--paper-2);
  }
  .body {
    margin: clamp(40px, 6vw, 72px) 0 0 auto;
    font-size: var(--t-m);
  }
  .rel {
    max-width: var(--text);
    margin-left: auto;
  }
</style>
