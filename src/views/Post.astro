---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Book from '~/layouts/Book.astro';
import Facade from '~/components/Facade.astro';
import { PHI } from '~/lib/geometry';
import Name from '~/components/Name.astro';
import { getProject } from '~/data/projects';
import { u, postUrl, projectUrl, formatDate, type Lang } from '~/i18n/ui';

interface Props {
  post: CollectionEntry<'journal'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const slug = post.id.split('/')[1];
const { Content } = await render(post);
const project = post.data.project ? getProject(post.data.project) : undefined;
---

<Book
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternates={{ tr: postUrl(slug, 'tr'), en: postUrl(slug, 'en') }}
  image={post.data.cover}
  type="article"
  running={lang === 'tr' ? 'Notlar' : 'Notes'}
>
  <article class="wrap post">
    <header class="head">
      <p class="sec-head" aria-hidden="true"><span class="n">03</span><b>{lang === 'tr' ? 'Notlar' : 'Notes'}</b><span class="fill"></span><span class="note">{post.data.date.getFullYear()}</span></p>
      <a class="label muted back" href={u(lang === 'tr' ? '/gunluk/' : '/en/journal/')}>← {lang === 'tr' ? 'Tüm notlar' : 'All notes'}</a>
      <time class="mono muted" datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
      <h1><Name text={post.data.title} lang={lang} /></h1>
      <p class="lead">{post.data.description}</p>
    </header>
    {!post.data.cover && <Facade seed={slug} class="post-land" ratio={PHI ** 3} levels={6} />}
    {
      post.data.cover && (
        <figure class="cover">
          <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[640, 960, 1400]} sizes="(min-width: 1100px) 1000px, 100vw" loading="eager" />
          {post.data.coverAlt && <figcaption>{post.data.coverAlt}</figcaption>}
        </figure>
      )
    }
    <div class="prose body"><Content /></div>
    {
      project && (
        <p class="rel">
          <a class="arrow-link" href={projectUrl(project.slug, lang)}>
            <Name text={project.title[lang]} lang={lang} />
          </a>
        </p>
      )
    }
  </article>
</Book>

<style>
  .post {
    max-width: 980px;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding-block: clamp(28px, 3.4vw, 48px) clamp(32px, 4vw, 48px);
  }
  .head .sec-head {
    width: 100%;
    margin-bottom: clamp(20px, 3vw, 40px);
  }
  .back {
    text-decoration: none;
  }
  h1 {
    font-size: var(--t-xxl);
    line-height: 0.9;
    margin-block: 8px 12px;
  }
  .lead {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--t-l);
    line-height: 1.3;
    color: var(--ink-2);
    margin: 0;
    max-width: 34em;
  }

  .cover :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    background: var(--paper-2);
  }
  .body {
    margin: clamp(40px, 6vw, 72px) 0 0 auto;
  }
  .rel {
    max-width: var(--text);
    margin-left: auto;
  }
</style>
