---
import { Image } from 'astro:assets';
import Book from '~/layouts/Book.astro';
import Fig from '~/components/Fig.astro';
import Land from '~/components/Land.astro';
import Name from '~/components/Name.astro';
import { formatCoords } from '~/lib/text';
import { cases, ROMAN, type Case } from '~/data/cases';
import { resolveRef } from '~/data/refs';
import { getProject, countryName } from '~/data/projects';
import { u, projectUrl, type Lang } from '~/i18n/ui';

interface Props {
  cs: Case;
  lang: Lang;
}
const { cs, lang } = Astro.props;
const p = getProject(cs.slug)!;
const i = cases.indexOf(cs);
const next = cases[(i + 1) % cases.length];
const nextP = getProject(next.slug)!;
const hero = resolveRef(cs.hero, cs.slug);
const place = [p.district?.[lang], p.city?.[lang]].filter(Boolean).join(', ');
const coords = p.coords ? formatCoords(p.coords[0], p.coords[1], lang) : undefined;
const L =
  lang === 'tr'
    ? { deep: 'Derinlemesine', place: 'Yer', year: 'Yıl', client: 'İşveren', award: 'Ödül', status: 'Durum', scope: 'Kapsam', next: 'Sonraki inceleme', index: 'Tüm çalışmalar' }
    : { deep: 'In depth', place: 'Place', year: 'Year', client: 'Client', award: 'Award', status: 'Status', scope: 'Scope', next: 'Next study', index: 'All works' };
const facts: [string, string][] = [
  [L.place, [place, countryName(p.country, lang)].filter(Boolean).join(' · ')],
  ...(p.year ? ([[L.year, String(p.year)]] as [string, string][]) : []),
  ...(p.client ? ([[L.client, p.client]] as [string, string][]) : []),
  ...(p.award ? ([[L.award, p.award[lang]]] as [string, string][]) : []),
  ...(p.status ? ([[L.status, p.status[lang]]] as [string, string][]) : []),
  [L.scope, p.scope[lang].join(', ')],
];
let figN = 0;
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'tr' ? 'Çalışmalar' : 'Works', item: new URL(u(lang === 'tr' ? '/projeler/' : '/en/projects/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: p.title[lang], item: new URL(projectUrl(cs.slug, lang), Astro.site).href },
  ],
};
const ld = {
  '@type': 'Article',
  headline: `${cs.question[lang]} — ${p.title[lang]}`,
  about: { '@type': 'CreativeWork', name: p.title[lang], ...(p.award ? { award: p.award[lang] } : {}) },
  author: { '@id': 'https://www.demirce.com/#ofis' },
  inLanguage: lang,
};
---

<Book
  lang={lang}
  title={`${p.title[lang]} — ${cs.question[lang]}`}
  description={cs.lead[lang]}
  alternates={{ tr: projectUrl(cs.slug, 'tr'), en: projectUrl(cs.slug, 'en') }}
  image={hero}
  type="article"
  running={`${L.deep} ${ROMAN[i]} — ${p.title[lang]}`}
  jsonLd={[ld, crumbs]}
>
  <article>
    <header class="wrap c-head">
      <p class="sec-head" aria-hidden="true"><span class="n">{String(i + 1).padStart(2, '0')}</span><b>{L.deep}</b><span class="fill"></span><span class="note">{ROMAN[i]} / {ROMAN[cases.length - 1]}</span></p>
      <div class="c-grid">
        <div class="c-text fade">
          <h1 class="q c-q">{cs.question[lang]}</h1>
          <p class="pname"><Name text={p.title[lang]} lang={lang} /></p>
          {(place || p.year) && <p class="pmeta mono">{[place, p.year].filter(Boolean).join(' · ')}</p>}
          {
            coords && (
              <p class="sign c-sign">
                <b>
                  <Name text={p.title[lang]} lang={lang} />
                </b>
                <span>{coords}</span>
              </p>
            )
          }
        </div>
        <Land seed={cs.slug} photo={hero} alt={p.title[lang]} class="c-land" threshold={0.5} bias={0.18} biasCenter={0.4} hair={0.06} />
      </div>
    </header>

    <div class="wrap">
      <div class="intro">
        <dl class="facts">
          {
            facts.map(([k, v]) => (
              <div>
                <dt class="mono muted">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="lead">{cs.lead[lang]}</p>
      </div>
    </div>

    <figure class={`c-hero ${hero.width < 1400 ? 'c-hero--small' : ''}`}>
      <Image src={hero} alt={p.title[lang]} widths={[800, 1200, 1600, 2000].filter((w) => w <= hero.width)} sizes="100vw" loading="lazy" />
    </figure>

    <div class="wrap">
      {
        cs.chapters.map((ch, k) => (
          <section class="chapter" aria-labelledby={`ch-${k}`}>
            <div class="ch-text">
              <header class="ch-head">
                <span class="ch-n mono muted">{String(k + 1).padStart(2, '0')}</span>
                <h2 id={`ch-${k}`}>{ch.title[lang]}</h2>
              </header>
              <div class="prose">
                {ch.body[lang].map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            </div>
            {ch.figures?.map((f) => (
              <Fig fig={f} slug={cs.slug} lang={lang} n={++figN} alt={p.title[lang]} />
            ))}
          </section>
        ))
      }
    </div>

    <nav class="wrap c-next" aria-label={L.next}>
      <a href={projectUrl(next.slug, lang)} class="next">
        <span class="label muted">{L.next} — {ROMAN[(i + 1) % cases.length]}</span>
        <span class="q nq">{next.question[lang]}</span>
        <span class="nn"><Name text={nextP.title[lang]} lang={lang} /></span>
      </a>
      <a class="arrow-link" href={u(lang === 'tr' ? '/projeler/' : '/en/projects/')}>{L.index}</a>
    </nav>
  </article>
</Book>

<style>
  .c-head {
    padding-block: clamp(28px, 3.4vw, 48px) clamp(48px, 6vw, 88px);
  }
  .c-head .sec-head {
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  .c-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 88px);
    align-items: stretch;
  }
  .c-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .c-q {
    font-size: var(--t-xxl);
    line-height: 1;
    max-width: 13em;
    margin: 0 0 clamp(28px, 4vw, 56px);
  }
  .pname {
    font-family: var(--display);
    font-stretch: 68%;
    font-weight: 560;
    font-size: var(--t-xl);
    line-height: 0.92;
    text-transform: uppercase;
    margin: auto 0 10px;
  }
  .pmeta {
    color: var(--muted);
    text-transform: uppercase;
    margin: 0 0 24px;
  }
  .c-sign {
    margin: 0;
  }
  .c-grid :global(.c-land) {
    min-height: min(72svh, 760px);
  }
  @media (max-width: 860px) {
    .c-grid {
      grid-template-columns: 1fr;
    }
    .c-grid :global(.c-land) {
      min-height: 0;
      aspect-ratio: 4 / 5;
      max-height: 70svh;
      order: -1;
    }
    .pname {
      margin-top: 0;
    }
  }
  .c-hero :global(img) {
    width: 100%;
    max-height: 92vh;
    object-fit: cover;
  }
  /* Düşük çözünürlüklü görseller tam genişliğe yayılmaz */
  .c-hero--small {
    max-width: min(1100px, calc(100% - 2 * var(--gutter)));
    margin-inline: auto;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(0, 2fr);
    gap: clamp(24px, 6vw, 96px);
    padding-block: clamp(32px, 4vw, 56px) clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--ink);
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .facts div {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 12px;
    font-size: var(--t-s);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    text-transform: uppercase;
    padding-top: 2px;
  }
  .facts dd {
    margin: 0;
  }
  .lead {
    font-size: var(--t-l);
    line-height: 1.36;
    letter-spacing: -0.01em;
    font-weight: 380;
    margin: 0;
  }
  .chapter {
    padding-block: clamp(56px, 8vw, 120px) 0;
  }
  .ch-text {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(0, 2fr);
    gap: clamp(24px, 6vw, 96px);
  }
  .ch-head {
    position: sticky;
    top: calc(var(--header-h) + 16px);
    align-self: start;
  }
  .ch-n {
    display: block;
    margin-bottom: 8px;
  }
  .ch-head h2 {
    font-size: var(--t-xxl);
    line-height: 0.88;
  }
  .prose {
    font-size: var(--t-m);
    color: var(--ink-2);
  }
  .prose p:first-child {
    color: var(--ink);
  }
  .c-next {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-top: clamp(72px, 10vw, 140px);
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }
  .next {
    display: grid;
    gap: 10px;
    text-decoration: none;
  }
  .nq {
    font-size: var(--t-xl);
    line-height: 1.04;
  }
  .nn {
    font-family: var(--display);
    font-stretch: 68%;
    font-weight: 560;
    font-size: var(--t-l);
    text-transform: uppercase;
    line-height: 1;
  }
  .next:hover .nq {
    text-decoration: underline;
    text-decoration-color: var(--rule-2);
  }
  @media (max-width: 860px) {
    .intro,
    .ch-text {
      grid-template-columns: 1fr;
    }
    .ch-head {
      position: static;
    }
    .c-next {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
