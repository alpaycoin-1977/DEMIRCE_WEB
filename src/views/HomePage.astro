---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import SunStudy from '~/components/SunStudy.astro';
import SectionHead from '~/components/SectionHead.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ProjectMap from '~/components/ProjectMap.astro';
import Timeline from '~/components/Timeline.astro';
import JournalCard from '~/components/JournalCard.astro';
import Icon from '~/components/Icon.astro';
import { projects } from '~/data/projects';
import { archive } from '~/data/archive';
import { services } from '~/data/services';
import { SITE } from '~/data/site';
import { ROUTES, t, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
// Ana sayfada öne çıkan projeler (sıra önemlidir: 1 ve 4 geniş, 2-3 dar, 5-6 eşit)
const FEATURED = ['fenix84-antalya', 'mezitli-egitim-kampusu', 'otel-lusso', 'coordinat-bornova', 'iztu-kampus-yarismasi', 'ural-houses-kazakistan'];
const featured = FEATURED.map((s) => projects.find((p) => p.slug === s)!).filter(Boolean);
const years = new Date().getFullYear() - SITE.founded;
const cities = new Set(projects.filter((p) => p.city).map((p) => p.city!.tr));
const posts = (await getCollection('journal', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const c =
  lang === 'tr'
    ? {
        eyebrow: `DEMİRCE Mimarlık · İzmir · ${SITE.founded}'dan beri`,
        h1: ['Doğru soruları', 'doğru zamanda', 'soruyoruz.'],
        intro: 'Otel, büyük ölçekli konut ve karma kullanım projelerinde mimari, iç mimari ve peyzajı tek bir konsept altında tasarlıyoruz.',
        explore: 'Projeleri keşfet',
        marquee: ['Otel', 'Rezidans', 'Karma Kullanım', 'Eğitim', 'İç Mimari', 'Peyzaj', 'Kentsel Dönüşüm', 'Yarışma'],
        approachLabel: 'Yaklaşım',
        manifesto:
          'DEMİRCE, projeleri — mimari, iç mimari, peyzaj — mekânı tanımlayan adımlar olarak görür ve tek bir konsept altında şekillendirir. Dünya kaynaklarına saygılı mekânlar üretmeyi sorumluluk bilir.',
        pillars: [
          ['İşlevsel', 'Her metrekare bir amaca hizmet eder; yalınlık, işlevin en net ifadesidir.'],
          ['Estetik', 'Malzeme, ışık ve oran; kullanıcının mekânla kurduğu duygusal bağı biçimlendirir.'],
          ['Yenilikçi', 'Klasik yaklaşımları yeniden sorgular, programı ve biçimi birlikte yeniden kurarız.'],
        ],
        workLabel: 'Seçili işler',
        workTitle: 'Projeler',
        statsLabel: 'Rakamlarla',
        stats: [
          [String(SITE.founded), 'Kuruluş yılı'],
          [String(years), 'Yıllık deneyim'],
          [String(projects.length + archive.length), 'Sitede yer alan proje'],
          [`${cities.size}`, 'Şehir · 2 ülke'],
          ['3', 'Ödül'],
        ],
        servicesLabel: 'Hizmetler',
        servicesTitle: 'Ne yapıyoruz',
        mapLabel: 'Haritada',
        mapTitle: 'İzmir’den Atırav’a',
        tlLabel: 'Zaman çizelgesi',
        tlTitle: 'Yolculuk',
        toolsLabel: 'Sıra dışı araçlar',
        toolsTitle: 'Projeye bugün başlayın',
        tools: [
          {
            k: 'feasibility' as const,
            t: 'Arsa Potansiyeli Hesaplayıcı',
            d: 'Arsa alanı, emsal ve TAKS’ı girin; inşaat alanını, kat adedini ve oda / daire kapasitesini anında görün. Sonucu tek tıkla ofisimize iletin.',
            cta: 'Hesaplayıcıyı aç',
            icon: 'layers' as const,
          },
          {
            k: 'board' as const,
            t: 'İlham Panosu',
            d: 'Proje galerilerinde beğendiğiniz görselleri ♥ ile panonuza ekleyin; panonuzu paylaşın ya da tasarım brifinize ekleyerek bize gönderin.',
            cta: 'Panoyu aç',
            icon: 'heart' as const,
          },
          {
            k: 'home' as const,
            t: 'Güneş Çalışması',
            d: 'Bu sayfanın başındaki maket, Alsancak’taki ofisimizin koordinatlarında güneşin bugünkü gerçek konumunu gösteriyor. Saati kaydırın, gün dönümlerini deneyin, İmbat’ı açın.',
            cta: 'Yukarı çık',
            icon: 'sun' as const,
          },
        ],
        journalLabel: 'Günlük',
        journalTitle: 'Ofisten notlar',
      }
    : {
        eyebrow: `DEMİRCE Architects · İzmir · since ${SITE.founded}`,
        h1: ['Asking the right', 'questions at the', 'right time.'],
        intro: 'We design hotels, large-scale residential and mixed-use projects — bringing architecture, interiors and landscape together under one concept.',
        explore: 'Explore projects',
        marquee: ['Hotels', 'Residences', 'Mixed-Use', 'Education', 'Interiors', 'Landscape', 'Urban Regeneration', 'Competitions'],
        approachLabel: 'Approach',
        manifesto:
          'DEMİRCE sees every project — architecture, interiors, landscape — as steps that define a space, shaped under a single concept. We take responsibility for making places that respect the world’s resources.',
        pillars: [
          ['Functional', 'Every square metre serves a purpose; simplicity is the clearest expression of function.'],
          ['Aesthetic', 'Material, light and proportion shape the emotional bond between people and space.'],
          ['Innovative', 'We question conventions and rebuild brief and form together.'],
        ],
        workLabel: 'Selected work',
        workTitle: 'Projects',
        statsLabel: 'In numbers',
        stats: [
          [String(SITE.founded), 'Founded'],
          [String(years), 'Years of practice'],
          [String(projects.length + archive.length), 'Projects on this site'],
          [`${cities.size}`, 'Cities · 2 countries'],
          ['3', 'Awards'],
        ],
        servicesLabel: 'Services',
        servicesTitle: 'What we do',
        mapLabel: 'On the map',
        mapTitle: 'From İzmir to Atyrau',
        tlLabel: 'Timeline',
        tlTitle: 'The journey',
        toolsLabel: 'Unusual tools',
        toolsTitle: 'Start your project today',
        tools: [
          {
            k: 'feasibility' as const,
            t: 'Site Potential Calculator',
            d: 'Enter site area, FAR and site coverage to instantly see buildable area, storeys and room / unit capacity. Send the result to our studio in one click.',
            cta: 'Open calculator',
            icon: 'layers' as const,
          },
          {
            k: 'board' as const,
            t: 'Mood Board',
            d: 'Add images you like from project galleries with ♥, share your board, or attach it to your brief and send it to us.',
            cta: 'Open board',
            icon: 'heart' as const,
          },
          {
            k: 'home' as const,
            t: 'Sun Study',
            d: 'The model at the top of this page shows today’s real sun position at our studio in Alsancak. Scrub the time, try the solstices, switch on the İmbat breeze.',
            cta: 'Back to top',
            icon: 'sun' as const,
          },
        ],
        journalLabel: 'Journal',
        journalTitle: 'Notes from the studio',
      };
const words = c.manifesto.split(' ');
---

<Base lang={lang} route="home" sheet="A-00">
  <SunStudy lang={lang}>
    <div class="hero-text">
      <p class="label hero-eyebrow">{c.eyebrow}</p>
      <h1 class="display hero-h1">
        {c.h1.map((l) => <span class="line">{l}</span>)}
      </h1>
      <p class="hero-intro">{c.intro}</p>
      <div class="hero-cta">
        <a class="btn" href={ROUTES.projects[lang]}>{c.explore} <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost hero-ghost" href={ROUTES.feasibility[lang]}>{tr('nav.start')}</a>
      </div>
    </div>
  </SunStudy>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => c.marquee.map((m) => <span class="display">{m}<i>✕</i></span>))}
    </div>
  </div>

  <section class="section wrap manifesto" aria-labelledby="yaklasim">
    <span class="label muted"><span class="accent">01 — </span>{c.approachLabel}</span>
    <h2 id="yaklasim" class="sr-only">{c.approachLabel}</h2>
    <p class="manifesto-text">
      {words.map((w) => <span class="w">{w} </span>)}
    </p>
    <ol class="pillars">
      {
        c.pillars.map(([h, p], i) => (
          <li class="reveal">
            <span class="label muted">0{i + 1}</span>
            <h3 class="display">{h}</h3>
            <p>{p}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="isler">
    <SectionHead index="02" label={c.workLabel} title={c.workTitle} id="isler" href={ROUTES.projects[lang]} linkText={`${tr('common.allProjects')} (${projects.length})`} />
    <div class="featured">
      {featured.map((p, i) => <ProjectCard project={p} lang={lang} index={i + 1} size={i % 6 === 0 || i % 6 === 3 ? 'l' : 'm'} />)}
    </div>
  </section>

  <section class="stats" aria-label={c.statsLabel}>
    <div class="wrap stats-grid">
      {
        c.stats.map(([n, l]) => (
          <div class="stat reveal">
            <span class="display stat-n">{n}</span>
            <span class="label">{l}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section wrap" aria-labelledby="hizmetler">
    <SectionHead index="03" label={c.servicesLabel} title={c.servicesTitle} id="hizmetler" href={ROUTES.services[lang]} linkText={tr('nav.services')} />
    <ol class="svc">
      {
        services.map((s, i) => (
          <li class="reveal">
            <a href={`${ROUTES.services[lang]}#${s.id}`}>
              <span class="label muted">{String(i + 1).padStart(2, '0')}</span>
              <span class="display svc-t">{s.title[lang]}</span>
              <span class="svc-d">{s.short[lang]}</span>
              <Icon name="arrow-up-right" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="harita-baslik">
    <SectionHead index="04" label={c.mapLabel} title={c.mapTitle} id="harita-baslik" href={`${ROUTES.projects[lang]}?view=map`} linkText={tr('view.map')} />
    <ProjectMap lang={lang} id="ana-harita" />
  </section>

  <section class="section wrap" aria-labelledby="zaman">
    <SectionHead index="05" label={c.tlLabel} title={c.tlTitle} id="zaman" href={ROUTES.office[lang]} linkText={tr('nav.office')} />
    <Timeline lang={lang} />
  </section>

  <section class="section wrap" aria-labelledby="araclar">
    <SectionHead index="06" label={c.toolsLabel} title={c.toolsTitle} id="araclar" />
    <div class="tools">
      {
        c.tools.map((tool) => (
          <a class="tool reveal crop" href={tool.k === 'home' ? '#icerik' : ROUTES[tool.k][lang]}>
            <Icon name={tool.icon} size={28} />
            <h3 class="display">{tool.t}</h3>
            <p>{tool.d}</p>
            <span class="link-arrow">
              {tool.cta} <Icon name="arrow-right" size={16} />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section wrap" aria-labelledby="gunluk">
    <SectionHead index="07" label={c.journalLabel} title={c.journalTitle} id="gunluk" href={ROUTES.journal[lang]} linkText={tr('nav.journal')} />
    <div class="journal">
      {posts.map((p) => <JournalCard post={p} lang={lang} />)}
    </div>
  </section>
</Base>

<style>
  .hero-text {
    max-width: min(760px, 62vw);
  }
  .hero-eyebrow {
    margin-bottom: 20px;
    opacity: 0.85;
  }
  .hero-h1 {
    font-size: clamp(3rem, 1.6rem + 5.4vw, 8.25rem);
    margin-bottom: 28px;
  }
  .hero-h1 .line {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-h1 .line {
      animation: rise 1s var(--ease-out) both;
    }
    .hero-h1 .line:nth-child(2) {
      animation-delay: 0.08s;
    }
    .hero-h1 .line:nth-child(3) {
      animation-delay: 0.16s;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
  }
  .hero-intro {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
    margin-bottom: 28px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  :global(.sun.is-dark) .hero-text .btn:not(.btn--ghost) {
    --btn-bg: #f3f1ec;
    --btn-fg: #151515;
  }
  :global(.sun.is-dark) .hero-ghost {
    --btn-fg: #f3f1ec;
    border-color: rgb(243 241 236 / 0.5);
  }
  @media (max-width: 760px) {
    .hero-text {
      max-width: none;
    }
    .hero-intro {
      font-size: var(--step-0);
    }
  }

  /* Kayan şerit */
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 14px;
    background: var(--paper);
    position: relative;
    z-index: 1;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 40s linear infinite;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee span {
    font-size: var(--step-2);
    padding-inline: 18px;
    white-space: nowrap;
  }
  .marquee i {
    font-style: normal;
    margin-left: 36px;
    color: var(--accent);
    font-size: 0.6em;
    vertical-align: 0.3em;
  }

  /* Manifesto */
  .manifesto-text {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-size: var(--step-3);
    line-height: 1.12;
    margin: 28px 0 clamp(48px, 7vw, 96px);
    max-width: 30ch;
    text-wrap: pretty;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .manifesto-text .w {
        animation: ink linear both;
        animation-timeline: view();
        animation-range: cover 10% cover 45%;
      }
    }
  }
  @keyframes ink {
    from {
      color: var(--line-strong);
    }
    to {
      color: var(--ink);
    }
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pillars li {
    border-top: 1px solid var(--ink);
    padding-top: 16px;
  }
  .pillars h3 {
    font-size: var(--step-3);
    margin: 12px 0;
  }
  .pillars p {
    color: var(--ink-2);
  }

  /* Seçili işler */
  .featured {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 64px) clamp(16px, 2vw, 32px);
  }
  .featured > :global(.pcard:nth-child(6n + 1)),
  .featured > :global(.pcard:nth-child(6n + 4)) {
    grid-column: span 8;
  }
  .featured > :global(.pcard:nth-child(6n + 2)),
  .featured > :global(.pcard:nth-child(6n + 3)) {
    grid-column: span 4;
    align-self: end;
  }
  .featured > :global(.pcard:nth-child(6n + 3)) {
    align-self: start;
  }
  .featured > :global(.pcard:nth-child(6n + 5)),
  .featured > :global(.pcard:nth-child(6n + 6)) {
    grid-column: span 6;
  }

  /* Rakamlar */
  .stats {
    background: var(--ink);
    color: var(--paper);
    position: relative;
    z-index: 1;
  }
  :global([data-theme='blueprint']) .stats {
    background: var(--paper-3);
    color: var(--ink);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .stat {
    display: grid;
    gap: 10px;
    padding: clamp(32px, 5vw, 64px) 16px;
    border-left: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat-n {
    font-size: var(--step-5);
  }
  .stat .label {
    opacity: 0.7;
  }

  /* Hizmetler listesi */
  .svc {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .svc a {
    display: grid;
    grid-template-columns: 60px minmax(0, 1.2fr) minmax(0, 1fr) 24px;
    align-items: center;
    gap: 20px;
    padding: clamp(18px, 2.2vw, 28px) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      padding 0.4s var(--ease-out),
      background 0.3s;
  }
  .svc a:hover {
    padding-left: 16px;
    padding-right: 16px;
    background: var(--paper-2);
  }
  .svc-t {
    font-size: var(--step-3);
  }
  .svc-d {
    color: var(--ink-2);
  }
  .svc a:hover .svc-t {
    color: var(--accent-text);
  }

  /* Araçlar */
  .tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
  }
  .tool {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line-strong);
    text-decoration: none;
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .tool:hover {
    background: var(--paper-2);
    border-color: var(--accent);
  }
  .tool h3 {
    font-size: var(--step-3);
  }
  .tool p {
    color: var(--ink-2);
    margin: 0;
  }
  .tool .link-arrow {
    justify-self: start;
    margin-top: 8px;
  }

  /* Günlük */
  .journal {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 40px);
  }

  @media (max-width: 900px) {
    .pillars,
    .tools,
    .journal {
      grid-template-columns: 1fr;
    }
    .featured {
      grid-template-columns: 1fr;
    }
    .featured > :global(.pcard) {
      grid-column: auto !important;
    }
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat {
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
      padding-left: 0;
    }
    .svc a {
      grid-template-columns: 40px 1fr 24px;
    }
    .svc-d {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
