---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import SectionHead from '~/components/SectionHead.astro';
import Timeline from '~/components/Timeline.astro';
import Icon from '~/components/Icon.astro';
import { SITE } from '~/data/site';
import { projectCover } from '~/lib/images';
import { t, postUrl, projectUrl, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const years = new Date().getFullYear() - SITE.founded;
const mosaic = ['coordinat-bornova-ic-mekan', 'fenix84-antalya', 'otel-lusso'].map((s) => projectCover(s));

/*
 * EKİP — eski sitedeki yazılardan derlenmiştir. Unvanları ve kişileri
 * yayına almadan önce lütfen kontrol edin / güncelleyin.
 */
const people = [
  {
    name: 'Alpay Demirci',
    role: { tr: 'Mimar · Kurucu Ortak', en: 'Architect · Co-founder' },
    quote: {
      tr: '“DEMİRCE, sadece bir ofis adı değil, bizim için bir yaşama biçimi.”',
      en: '“DEMİRCE is not just the name of an office; for us it is a way of life.”',
    },
  },
  {
    name: 'Burçin Demirci',
    role: { tr: 'Kurucu Ortak', en: 'Co-founder' },
    quote: { tr: '“Biz duygularımızı katıyoruz, projelere.”', en: '“We put our feelings into our projects.”' },
  },
];

const c =
  lang === 'tr'
    ? {
        title: 'Ofis',
        lead: `${SITE.founded} yılında kurucularının başladığı mimari yolculuğun adı. ${years} yıldır İzmir Alsancak’tan.`,
        about: [
          'DEMİRCE, projeleri (mimari, iç mimari, peyzaj düzenlemesi vb.) mekânı tanımlayan adımlar olarak görüp tek bir konsept altında şekillendirir. Tasarım işlevsel, estetik ve yenilikçi olmalı; kullanıcıların yaşamlarıyla bütünleşmeli ve çevreye değer katmalıdır.',
          'DEMİRCE, dünya kaynaklarına saygılı bir şekilde mekânlar üretme sorumluluğunu üstlenmiştir. Mimariyi düşünsel boyutlarına teorik referanslarla, üretilebilirlik açısından ise pratik olarak işletilmesi gereken bir organizma olarak görür. DEMİRCE, doğru soruları doğru zamanda sormayı amaçlayan bir vizyondur ve bulduğu cevaplar doğru mekânlara ışık tutar.',
        ],
        valuesLabel: 'İlkeler',
        valuesTitle: 'Beş temel unsur',
        values: [
          ['Fonksiyonellik', 'Mekân önce işler; her karar kullanıcının gündelik hayatından doğar.'],
          ['Yenilikçilik', 'Rezidansı, öğrenci yurdunu, şehir otelini yeniden tanımlamaktan çekinmeyiz.'],
          ['Yalınlık', 'En az malzemeyle en net sonuca: gereksizi ayıklamak bir tasarım eylemidir.'],
          ['Yaşamla bütünleşmek', 'Yalnızca bir konut değil, bir yaşam tasarlarız.'],
          ['Çevreye değer katmak', 'Güneş, rüzgâr ve manzara ilk tasarım girdilerimizdir; yapı kentine bir şey bırakmalıdır.'],
        ],
        valuesSource: '— Alpay Demirci, 2013',
        peopleLabel: 'Ekip',
        peopleTitle: 'Kurucular',
        tlLabel: 'Zaman çizelgesi',
        tlTitle: `${SITE.founded} → bugün`,
        recLabel: 'Ödüller, basın, sergiler',
        recTitle: 'Tanınırlık',
        rec: [
          ['2018', 'İZTÜ Kampüs Yerleşkesi Tasarım Yarışması — Eşdeğer İkinci Ödül', projectUrl('iztu-kampus-yarismasi', lang)],
          ['2014', 'Mimarizm — Evzen, ayın projesi', postUrl('mimarizm-evzen', lang)],
          ['2014', 'İzmir Mimarlık Merkezi — “Bir Mimar ve Uygulamaları” söyleşisi', postUrl('bir-mimar-ve-uygulamalari', lang)],
          ['2014', 'İzmir SMD 10. Yıl Sergisi — İzmir Ticaret Odası', postUrl('izmir-smd-10-yil-sergisi', lang)],
          ['2013', 'M.E.B. Mersin Mezitli Eğitim Kampüsü Yarışması — Birincilik Ödülü', projectUrl('mezitli-egitim-kampusu', lang)],
          ['2013', 'Hürriyet — “Simgesel yapılarla farkını ortaya koy” röportajı', postUrl('hurriyet-roportaj-simgesel-yapilar', lang)],
          ['2013', 'Koleksiyon / İzmir SMD Mimarları Ağırlıyor — 10. konuk, 15 proje', postUrl('koleksiyon-ismd-sergisi', lang)],
          ['2007', 'CNBC Best Architecture Ödülü', ''],
        ],
        careersTitle: 'Ekibe katılın',
        careersText: 'Mimar, iç mimar ve peyzaj mimarı adaylarının ve stajyerlerin portfolyolarını bekliyoruz. Kısa bir ön yazı ve PDF portfolyonuzu e-postayla gönderin.',
        careersCta: 'Portfolyo gönder',
        partnersLabel: 'Birlikte çalıştıklarımızdan',
        partners: ['Fenix A.Ş.', 'BYY İnşaat', 'Ekin Koleji', 'Ofis Vesaire', 'Oksijen360', 'T.C. Milli Eğitim Bakanlığı (yarışma)'],
      }
    : {
        title: 'Studio',
        lead: `The name of the architectural journey its founders began in ${SITE.founded}. ${years} years in Alsancak, İzmir.`,
        about: [
          'DEMİRCE sees projects — architecture, interiors, landscape and more — as steps that define a space, and shapes them under a single concept. Design must be functional, aesthetic and innovative; it should merge with people’s lives and add value to its surroundings.',
          'DEMİRCE takes responsibility for producing spaces that respect the world’s resources. It sees architecture as an organism to be run both through theoretical references to its intellectual dimensions and practically, in terms of buildability. DEMİRCE is a vision that aims to ask the right questions at the right time — and the answers it finds shed light on the right spaces.',
        ],
        valuesLabel: 'Principles',
        valuesTitle: 'Five essentials',
        values: [
          ['Functionality', 'Space works first; every decision grows out of everyday life.'],
          ['Innovation', 'We are not afraid to redefine the residence, the student home, the city hotel.'],
          ['Simplicity', 'The clearest result with the least material: editing is a design act.'],
          ['Integrating with life', 'We design not just a home, but a way of living.'],
          ['Adding value', 'Sun, wind and view are our first inputs; a building should give something back to its city.'],
        ],
        valuesSource: '— Alpay Demirci, 2013',
        peopleLabel: 'Team',
        peopleTitle: 'Founders',
        tlLabel: 'Timeline',
        tlTitle: `${SITE.founded} → today`,
        recLabel: 'Awards, press, exhibitions',
        recTitle: 'Recognition',
        rec: [
          ['2018', 'İZTÜ Campus Design Competition — Joint Second Prize', projectUrl('iztu-kampus-yarismasi', lang)],
          ['2014', 'Mimarizm — Evzen, project of the month', postUrl('mimarizm-evzen', lang)],
          ['2014', 'İzmir Architecture Centre — “An Architect and Their Work” talk', postUrl('bir-mimar-ve-uygulamalari', lang)],
          ['2014', 'İzmir SMD 10th Anniversary Exhibition — İzmir Chamber of Commerce', postUrl('izmir-smd-10-yil-sergisi', lang)],
          ['2013', 'Mersin Mezitli Education Campus Competition — First Prize', projectUrl('mezitli-egitim-kampusu', lang)],
          ['2013', 'Hürriyet — “Make your mark with iconic buildings” interview', postUrl('hurriyet-roportaj-simgesel-yapilar', lang)],
          ['2013', 'Koleksiyon / İzmir SMD Hosts Architects — 10th guest, 15 projects', postUrl('koleksiyon-ismd-sergisi', lang)],
          ['2007', 'CNBC Best Architecture Award', ''],
        ],
        careersTitle: 'Join the team',
        careersText: 'We welcome portfolios from architects, interior designers, landscape architects and interns. Send a short cover note and a PDF portfolio by email.',
        careersCta: 'Send portfolio',
        partnersLabel: 'Some of the people we have worked with',
        partners: ['Fenix A.Ş.', 'BYY İnşaat', 'Ekin College', 'Ofis Vesaire', 'Oksijen360', 'Ministry of National Education (competition)'],
      };
---

<Base lang={lang} title={c.title} description={c.lead} route="office" sheet="A-20">
  <div class="wrap page-head">
    <p class="label muted"><span class="accent">A-20 — </span>{tr('common.since')}</p>
    <h1 class="display">{c.title}</h1>
    <p class="lead">{c.lead}</p>
  </div>

  <div class="wrap mosaic">
    {mosaic.map((img, i) => <Image src={img} alt="" widths={[480, 800, 1200]} sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} loading={i === 0 ? 'eager' : 'lazy'} class="reveal-img" />)}
  </div>

  <section class="wrap section about">
    <div class="about-grid">
      <p class="label muted">DEMİRCE — <span lang="en">{SITE.alternateName}</span></p>
      <div class="about-text">
        {c.about.map((p, i) => <p class={i === 0 ? 'big' : ''}>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="ilkeler">
    <SectionHead index="01" label={c.valuesLabel} title={c.valuesTitle} id="ilkeler" />
    <ol class="values">
      {
        c.values.map(([h, p], i) => (
          <li class="reveal">
            <span class="display v-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display">{h}</h3>
            <p>{p}</p>
          </li>
        ))
      }
    </ol>
    <p class="mono muted source">{c.valuesSource}</p>
  </section>

  <section class="wrap section" aria-labelledby="ekip">
    <SectionHead index="02" label={c.peopleLabel} title={c.peopleTitle} id="ekip" />
    <div class="people">
      {
        people.map((p) => (
          <article class="person crop">
            <div class="mono-mark display" aria-hidden="true">
              {p.name
                .split(' ')
                .map((w) => w[0])
                .join('')}
            </div>
            <div>
              <h3 class="display">{p.name}</h3>
              <p class="label muted">{p.role[lang]}</p>
              <blockquote>{p.quote[lang]}</blockquote>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap section" aria-labelledby="zaman">
    <SectionHead index="03" label={c.tlLabel} title={c.tlTitle} id="zaman" />
    <Timeline lang={lang} />
  </section>

  <section class="wrap section" aria-labelledby="taninirlik">
    <SectionHead index="04" label={c.recLabel} title={c.recTitle} id="taninirlik" />
    <ul class="rec">
      {
        c.rec.map(([y, txt, href]) => (
          <li>
            <span class="mono">{y}</span>
            {href ? (
              <a href={href}>
                {txt} <Icon name="arrow-up-right" size={16} />
              </a>
            ) : (
              <span>{txt}</span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="label muted partners-label">{c.partnersLabel}</p>
    <ul class="partners">{c.partners.map((p) => <li class="display">{p}</li>)}</ul>
  </section>

  <section class="wrap careers crop" aria-labelledby="kariyer">
    <div>
      <h2 id="kariyer" class="display">{c.careersTitle}</h2>
      <p>{c.careersText}</p>
    </div>
    <a class="btn btn--accent" href={`mailto:${SITE.email}?subject=${encodeURIComponent(lang === 'tr' ? 'Portfolyo başvurusu' : 'Portfolio application')}`}>{c.careersCta} <Icon name="mail" /></a>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 120px) clamp(32px, 4vw, 56px);
  }
  .page-head h1 {
    font-size: var(--step-5);
    margin: 18px 0 24px;
  }
  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: clamp(8px, 1.2vw, 16px);
  }
  .mosaic :global(img) {
    width: 100%;
    height: clamp(240px, 38vw, 560px);
    object-fit: cover;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(24px, 6vw, 96px);
  }
  .about-text p {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .about-text .big {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-size: var(--step-3);
    line-height: 1.12;
    color: var(--ink);
  }
  .values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }
  .values li {
    border-top: 1px solid var(--ink);
    padding-top: 14px;
  }
  .v-n {
    font-size: var(--step-3);
    color: var(--accent-text);
  }
  .values h3 {
    font-size: var(--step-2);
    margin: 12px 0;
  }
  .values p {
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .source {
    margin-top: 24px;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
  }
  .person {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 28px;
    border: 1px solid var(--line-strong);
  }
  .mono-mark {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step-4);
  }
  .person h3 {
    font-size: var(--step-3);
  }
  .person .label {
    margin: 10px 0 0;
  }
  .person blockquote {
    margin: 16px 0 0;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .rec {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .rec li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
  }
  .rec a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .rec a:hover {
    color: var(--accent-text);
  }
  .partners-label {
    margin-top: 48px;
  }
  .partners {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }
  .partners li {
    font-size: var(--step-2);
    color: var(--ink-3);
  }
  .careers {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-block: clamp(32px, 5vw, 64px);
    border: 1px solid var(--line-strong);
    padding-inline: clamp(20px, 4vw, 56px);
    max-width: calc(var(--maxw) - 2 * var(--gutter));
  }
  .careers h2 {
    font-size: var(--step-4);
    margin-bottom: 12px;
  }
  .careers p {
    max-width: 56ch;
    color: var(--ink-2);
    margin: 0;
  }
  @media (max-width: 1000px) {
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-grid,
    .people {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
    }
    .mosaic :global(img:first-child) {
      grid-column: 1 / -1;
    }
    .values {
      grid-template-columns: 1fr;
    }
    .person {
      grid-template-columns: 72px 1fr;
      padding: 18px;
    }
    .careers {
      margin-inline: var(--gutter);
    }
  }
</style>
