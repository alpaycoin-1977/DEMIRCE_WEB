---
import { Image } from 'astro:assets';
import Book from '~/layouts/Book.astro';
import PageHead from '~/components/PageHead.astro';
import Facade from '~/components/Facade.astro';
import { approach } from '~/data/approach';
import { SITE } from '~/data/site';
import { timeline } from '~/data/timeline';
import { services } from '~/data/services';
import { getProject } from '~/data/projects';
import { projectCover } from '~/lib/images';
import { projectUrl, postUrl, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
/* Kurucular — eski sitedeki yazılardan derlendi; unvanları yayından önce doğrulayın. */
const people = [
  { name: 'Alpay Demirci', role: { tr: 'Mimar, kurucu ortak', en: 'Architect, co-founder' } },
  { name: 'Burçin Demirci', role: { tr: 'Kurucu ortak', en: 'Co-founder' } },
];
const c =
  lang === 'tr'
    ? {
        title: 'Ofis',
        p1: `DEMİRCE, ${SITE.founded} yılında kurucularının başladığı mimari yolculuğun adıdır.`,
        p2: 'Projeleri — mimari, iç mimari, peyzaj düzenlemesi — mekânı tanımlayan adımlar olarak görür ve tek bir konsept altında şekillendirir. Tasarım işlevsel, estetik ve yenilikçi olmalı; kullanıcıların yaşamlarıyla bütünleşmeli ve çevreye değer katmalıdır.',
        p3: 'DEMİRCE, dünya kaynaklarına saygılı bir şekilde mekânlar üretme sorumluluğunu üstlenmiştir. Mimariyi, düşünsel boyutlarına teorik referanslarla, üretilebilirlik açısından ise pratik olarak işletilmesi gereken bir organizma olarak görür. DEMİRCE, doğru soruları doğru zamanda sormayı amaçlayan bir vizyondur ve bulduğu cevaplar doğru mekânlara ışık tutar.',
        quote: '“DEMİRCE, sadece bir ofis adı değil, bizim için bir yaşama biçimi.”',
        quoteBy: 'Alpay Demirci',
        principles: 'Çalışma biçimi',
        areas: 'Çalışma alanları',
        areasNote: 'Mimari, iç mekân ve peyzaj tek bir düşünce altında',
        eg: 'Örnek',
        people: 'Kurucular',
        record: 'Kayıt',
        recordNote: 'Ödüller, yayınlar, sergiler',
        with: 'Birlikte çalıştıklarımızdan',
        partners: 'Fenix A.Ş., BYY İnşaat, Ekin Koleji, Ofis Vesaire, Oksijen360',
        join: 'Ekibe katılmak isteyen mimar, iç mimar ve peyzaj mimarlarının portfolyolarını',
        joinEnd: 'adresine bekliyoruz.',
      }
    : {
        title: 'Studio',
        p1: `DEMİRCE is the name of the architectural journey its founders began in ${SITE.founded}.`,
        p2: 'It treats every project — architecture, interiors, landscape — as steps that define a space, shaped under one concept. Design must be functional, aesthetic and innovative; it should merge with people’s lives and add value to its surroundings.',
        p3: 'DEMİRCE takes responsibility for making spaces that respect the world’s resources. It sees architecture as an organism to be run with theoretical references to its intellectual dimensions and practically in terms of buildability. DEMİRCE is a vision that aims to ask the right questions at the right time — and the answers it finds shed light on the right spaces.',
        quote: '“DEMİRCE is not just the name of an office; for us it is a way of life.”',
        quoteBy: 'Alpay Demirci',
        principles: 'How we work',
        areas: 'Areas of work',
        areasNote: 'Architecture, interiors and landscape as one idea',
        eg: 'See',
        people: 'Founders',
        record: 'Record',
        recordNote: 'Awards, publications, exhibitions',
        with: 'Some of the people we have worked with',
        partners: 'Fenix A.Ş., BYY İnşaat, Ekin College, Ofis Vesaire, Oksijen360',
        join: 'Architects, interior designers and landscape architects who would like to join us are welcome to send a portfolio to',
        joinEnd: '.',
      };
const press: { year: number; title: Record<Lang, string>; href?: { project?: string; post?: string } }[] = [
  { year: 2014, title: { tr: 'Mimarizm — Evzen, ayın projesi', en: 'Mimarizm — Evzen, project of the month' }, href: { post: 'mimarizm-evzen' } },
  { year: 2014, title: { tr: 'İzmir SMD 10. Yıl Sergisi, İzmir Ticaret Odası', en: 'İzmir SMD 10th Anniversary Exhibition, İzmir Chamber of Commerce' }, href: { post: 'izmir-smd-10-yil-sergisi' } },
  { year: 2013, title: { tr: 'Hürriyet — “Simgesel yapılarla farkını ortaya koy”', en: 'Hürriyet — “Make your mark with iconic buildings”' }, href: { post: 'hurriyet-roportaj-simgesel-yapilar' } },
];
const record = [...timeline.filter((m) => m.kind !== 'build' && m.year !== SITE.founded), ...press].sort((x, y) => y.year - x.year);
const img = projectCover('ilayda-avantgarde');
---

<Book lang={lang} title={c.title} description={c.p1} alternates={{ tr: '/ofis/', en: '/en/studio/' }}>
  <PageHead n="02" label={c.title} note={`${SITE.founded} —`} title={c.title} lead={c.p1} seed="ofis-alsancak" hair={0.74} />
  <section class="wrap about">
    <div class="cols">
      <p>{c.p2}</p>
      <p>{c.p3}</p>
    </div>
  </section>

  <figure class="wrap fig">
    <Image src={img} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 1520px) 1400px, 100vw" loading="lazy" />
  </figure>

  <section class="night quote-band">
    <div class="wrap qb">
      <blockquote class="quote">
        <p class="q">{c.quote}</p>
        <footer class="mono muted">— {c.quoteBy}, 2013</footer>
      </blockquote>
      <Facade seed="yasama-bicimi" class="qb-land" ratio={1 / 1.618} />
    </div>
  </section>

  <section class="wrap section" aria-labelledby="h-p">
    <h2 id="h-p" class="kicker"><b>{c.principles}</b></h2>
    <ol class="principles">
      {
        approach.map((a, k) => (
          <li>
            <span class="mono muted">{String(k + 1).padStart(2, '0')}</span>
            <h3>{a.title[lang]}</h3>
            <p>{a.body[lang]}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="h-a">
    <h2 id="h-a" class="kicker"><b>{c.areas}</b><span>{c.areasNote}</span></h2>
    <ol class="areas">
      {
        services.map((sv) => (
          <li class="rise">
            <h3>{sv.title[lang]}</h3>
            <p>{sv.body[lang]}</p>
            <p class="small muted">
              {c.eg}:{' '}
              {sv.projects.map((slug, k) => (
                <>
                  {k > 0 && ', '}
                  <a href={projectUrl(slug, lang)}>{getProject(slug)?.title[lang]}</a>
                </>
              ))}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="h-f">
    <h2 id="h-f" class="kicker"><b>{c.people}</b></h2>
    <ul class="people">
      {
        people.map((p) => (
          <li>
            <span class="pn">{p.name}</span>
            <span class="small muted">{p.role[lang]}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="h-r">
    <h2 id="h-r" class="kicker"><b>{c.record}</b><span>{c.recordNote}</span></h2>
    <ul class="record">
      {
        record.map((m) => {
          const href = m.href?.project ? projectUrl(m.href.project, lang) : m.href?.post ? postUrl(m.href.post, lang) : undefined;
          return (
            <li>
              <span class="mono muted">{m.year}</span>
              {href ? <a href={href}>{m.title[lang]}</a> : <span>{m.title[lang]}</span>}
            </li>
          );
        })
      }
    </ul>
    <p class="small muted with">{c.with}: {c.partners}</p>
  </section>

  <section class="wrap">
    <p class="join">{c.join} <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{c.joinEnd}</p>
  </section>
</Book>

<style>
  .about {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .cols {
    columns: 2 320px;
    column-gap: clamp(24px, 4vw, 64px);
    color: var(--ink-2);
    max-width: 64rem;
    margin-left: clamp(0px, 16vw, 280px);
  }
  .fig :global(img) {
    width: 100%;
    max-height: 80vh;
    object-fit: cover;
  }
  .quote-band {
    margin-top: clamp(72px, 10vw, 152px);
  }
  .qb {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 88px);
    align-items: center;
    padding-block: clamp(64px, 8vw, 120px);
  }
  .quote {
    margin: 0;
  }
  .quote p {
    font-size: var(--t-xxl);
    line-height: 1;
    margin-bottom: 20px;
  }
  .qb :global(.qb-land) {
    max-width: 420px;
    justify-self: center;
  }
  @media (max-width: 860px) {
    .qb {
      grid-template-columns: 1fr;
    }
    .qb :global(.qb-land) {
      max-width: 260px;
    }
  }
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 40px);
  }
  .principles li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--ink);
  }
  .principles h3 {
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.1rem);
    line-height: 0.92;
  }
  .principles p {
    font-size: var(--t-s);
    color: var(--ink-2);
    margin: 0;
  }
  @media (max-width: 1000px) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .principles {
      grid-template-columns: 1fr;
    }
  }
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) clamp(24px, 4vw, 64px);
  }
  .areas h3 {
    font-size: var(--t-l);
    margin-bottom: 12px;
  }
  .areas p {
    color: var(--ink-2);
    margin-bottom: 10px;
  }
  .areas a {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }
  .people li {
    display: grid;
    gap: 4px;
  }
  .pn {
    font-family: var(--display);
    font-stretch: 68%;
    font-weight: 560;
    font-size: var(--t-xl);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .record {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .record li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .record a {
    text-decoration: none;
  }
  .record a:hover {
    text-decoration: underline;
  }
  .with {
    margin-top: 28px;
  }
  .join {
    max-width: 34em;
    color: var(--ink-2);
  }
</style>
