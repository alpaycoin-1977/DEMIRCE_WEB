---
/**
 * ANA SAYFA — "Cephe".
 * Sayfa tek bir binanın görünüşüdür: çatıdan (+16,00) zemine (±0,00) inilir.
 * Oranlar Fibonacci / altın orandan, figürler Vitruvius'tan gelir.
 * Kapaktaki dar pencere altın spiralin gözüne oturur; her gün başka bir
 * çalışma o pencereden görünür. Tamamen gri tonlamalıdır.
 */
import { Image, getImage } from 'astro:assets';
import Book from '~/layouts/Book.astro';
import Logo from '~/components/Logo.astro';
import Name from '~/components/Name.astro';
import Scales from '~/components/Scales.astro';
import Figure from '~/components/Figure.astro';
import Vitruvius from '~/components/Vitruvius.astro';
import { cases, ROMAN } from '~/data/cases';
import { indexGroups } from '~/data/monograph';
import { resolveRef } from '~/data/refs';
import { services } from '~/data/services';
import { timeline } from '~/data/timeline';
import { projects, getProject, type Category } from '~/data/projects';
import { SITE } from '~/data/site';
import { projectCover } from '~/lib/images';
import { rng, FIB, POSES } from '~/lib/geometry';
import { formatCoords } from '~/lib/text';
import { u, projectUrl, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const TYPE: Record<Category, Record<Lang, string>> = {
  hotel: { tr: 'Konaklama', en: 'Hospitality' },
  residence: { tr: 'Konut', en: 'Housing' },
  mixed: { tr: 'Karma kullanım', en: 'Mixed use' },
  education: { tr: 'Eğitim', en: 'Education' },
  interior: { tr: 'İç mekân', en: 'Interiors' },
  competition: { tr: 'Yarışma', en: 'Competition' },
  industrial: { tr: 'Endüstri', en: 'Industry' },
};
const poseNames = Object.keys(POSES).filter((p) => !p.startsWith('vitruvian')) as (keyof typeof POSES)[];
const leads = cases.map((cs, i) => {
  const p = getProject(cs.slug)!;
  const r = rng(cs.slug);
  const people = Array.from({ length: 1 + Math.floor(r() * 3) }, () => ({ pose: poseNames[Math.floor(r() * poseNames.length)], x: 8 + r() * 78, mirror: r() < 0.5 }));
  return { cs, p, i, img: resolveRef(cs.hero, cs.slug), type: TYPE[p.categories[0]][lang], people };
});
// Pencere düzeni: 8 birimlik iki sıra, Fibonacci genişlikleri (5+3 / 3+2+3)
const SPANS = [5, 3, 3, 2, 3];

// Kesitler: Fibonacci açıklıklı bir cephe ızgarası. Boşluk kalmaz:
// çalışmalar yerleştirildikten sonra kalan her boşluk siyah / taranmış /
// boş bir panelle doldurulur (13 sütun masaüstü, 6 sütun telefon).
const rc = rng('demirce-kesitler');
const works = await Promise.all(
  projects.map(async (p) => ({
    p,
    src: (await getImage({ src: projectCover(p.slug), width: 520, format: 'webp', quality: 60 })).src,
    c: [2, 3, 3, 5][Math.floor(rc() * 4)],
    r: FIB[2 + Math.floor(rc() * 2)],
  })),
);
type Box = { x: number; y: number; c: number; r: number };
function pack(items: { c: number; r: number }[], cols: number) {
  const occ: boolean[][] = [];
  const isFree = (x: number, y: number, c: number, r: number) => {
    for (let j = y; j < y + r; j++) for (let i = x; i < x + c; i++) if (i >= cols || occ[j]?.[i]) return false;
    return true;
  };
  const mark = (x: number, y: number, c: number, r: number) => {
    for (let j = y; j < y + r; j++) {
      occ[j] ??= Array(cols).fill(false);
      for (let i = x; i < x + c; i++) occ[j][i] = true;
    }
  };
  const pos: Box[] = items.map((it) => {
    const c = Math.min(it.c, cols);
    for (let y = 0; y < 400; y++)
      for (let x = 0; x <= cols - c; x++)
        if (isFree(x, y, c, it.r)) {
          mark(x, y, c, it.r);
          return { x: x + 1, y: y + 1, c, r: it.r };
        }
    return { x: 1, y: 1, c, r: it.r };
  });
  const deco: (Box & { kind: string })[] = [];
  const kinds = ['black', 'hatch', 'void', 'hatch-h', 'black'];
  const rows = occ.length;
  for (let y = 0; y < rows; y++)
    for (let x = 0; x < cols; x++) {
      if (occ[y][x]) continue;
      let w = 1;
      while (w < 3 && x + w < cols && !occ[y][x + w]) w++;
      let h = 1;
      while (h < 2 && y + h < rows && isFree(x, y + h, w, 1)) h++;
      mark(x, y, w, h);
      deco.push({ x: x + 1, y: y + 1, c: w, r: h, kind: kinds[deco.length % kinds.length] });
    }
  return { pos, deco };
}
const packD = pack(works, 13);
const packM = pack(works.map((w) => ({ c: w.c >= 5 ? 4 : w.c, r: w.r })), 6);
const boxVars = (d: Box, mo: Box) => `--x:${d.x};--y:${d.y};--c:${d.c};--r:${d.r};--mx:${mo.x};--my:${mo.y};--mc:${mo.c};--mr:${mo.r}`;

// Paftanın kesikli ızgarası: Fibonacci aralıklı, yer yer çift çizgi
const sheetGrid = (() => {
  const xs = [0, 89, 233, 377, 466, 610, 754, 843, 987, 1131, 1220, 1364, 1508, 1597];
  const ys = [0, 89, 144, 233, 322, 377, 466, 555, 610, 699, 788, 843, 932, 987];
  let d = '';
  xs.forEach((x, i) => {
    d += `M${x} 0V1000`;
    if (i % 4 === 2) d += `M${x + 7} 0V1000`;
  });
  ys.forEach((y, i) => {
    d += `M0 ${y}H1600`;
    if (i % 5 === 3) d += `M0 ${y + 6}H1600M0 ${y + 13}H1600`;
  });
  return d;
})();
const awards = timeline.filter((m) => m.kind === 'award').sort((a, b) => b.year - a.year);
const index = indexGroups().flatMap((g) => g.items);
const coords = formatCoords(SITE.geo.lat, SITE.geo.lon, lang);
const worksUrl = u(lang === 'tr' ? '/projeler/' : '/en/projects/');
const officeUrl = u(lang === 'tr' ? '/ofis/' : '/en/studio/');

const c =
  lang === 'tr'
    ? {
        facade: 'Cephe',
        tag: 'Doğru soru, doğru zamanda',
        a: 'Mimarlık',
        b: 'İç mimarlık',
        cc: 'Peyzaj',
        b1: 'Oran, ışık ve tekrar üzerine kurulu.',
        b2: 'DEMİRCE’de her proje bir soruyla başlar: arazi, güneş, rüzgâr ve insan.',
        b3: '1999’dan bu yana İzmir’de; bir otel odasının detayından bir kent adasına kadar mimari, iç mekân ve peyzaj.',
        b4: 'DEMİRCE daha yalın, daha kalıcı ve yerine ait bir mimarlığı savunur.',
        q1: 'Doğru soru,',
        q2: 'doğru zamanda.',
        statement: `DEMİRCE, ${SITE.founded}’dan bu yana İzmir’de çalışan bir mimarlık ofisidir. Bir otel odasının detayından bir kent adasına kadar her ölçekte; mimariyi, iç mekânı ve peyzajı tek bir düşünce altında ele alır.`,
        explore: 'Çalışmaları keşfet',
        office: 'Ofis',
        window: 'Pencereden',
        note: 'Duvar bir altın dikdörtgendir; pencere, altın spiralin gözüne oturur.',
        deep: 'Derinlemesine',
        deepNote: 'Beş pencere, beş soru',
        officeH: 'Ofis',
        officeText: 'Her iş aynı yerden başlar: arazinin topoğrafyasını, güneşi, rüzgârı ve orada yaşayacak insanı okumak. İnsan ölçüdür; oran, onun bedeninden ve doğanın büyüme kuralından — Fibonacci’den — gelir.',
        vitruvius: 'Vitruvius: çember, kare ve insan; altın spiral ile',
        about: 'Ofis hakkında',
        facts: [
          { k: 'Ölçek', v: '1:20 — 1:5000', n: 'Bir otel odasının detayından bir kent adasına' },
          { k: 'Oran', v: 'φ = 1,618', n: 'Duvardan pencereye, plandan detaya' },
          { k: 'Süreklilik', v: `${SITE.founded} —`, n: 'İzmir’den Hazar kıyısına, aynı soruyla' },
        ],
        areas: 'Alanlar',
        awards: 'Ödüller',
        scales: 'Ölçekler',
        scalesNote: 'Detaydan kente',
        cuts: 'Kesitler',
        cutsNote: `${SITE.founded}’dan bu yana`,
        all: 'Tüm çalışmalar',
      }
    : {
        facade: 'Elevation',
        tag: 'The right question, at the right time',
        a: 'Architecture',
        b: 'Interiors',
        cc: 'Landscape',
        b1: 'Built on proportion, light and repetition.',
        b2: 'At DEMİRCE every project begins with a question: land, sun, wind and people.',
        b3: 'Since 1999 in İzmir; from the detail of a hotel room to a city block — architecture, interiors and landscape.',
        b4: 'DEMİRCE stands for an architecture that is simpler, lasting and of its place.',
        q1: 'The right question,',
        q2: 'at the right time.',
        statement: `DEMİRCE is an architecture studio that has worked from İzmir since ${SITE.founded}. From the detail of a hotel room to a city block, it treats architecture, interiors and landscape as a single idea.`,
        explore: 'Explore the work',
        office: 'Studio',
        window: 'Through the window',
        note: 'The wall is a golden rectangle; the window sits in the eye of the golden spiral.',
        deep: 'In depth',
        deepNote: 'Five windows, five questions',
        officeH: 'Studio',
        officeText: 'Every project starts in the same place: reading the topography, the sun, the wind and the people who will live there. The human being is the measure; proportion comes from the body and from nature’s rule of growth — Fibonacci.',
        vitruvius: 'Vitruvius: circle, square and figure, with the golden spiral',
        about: 'About the studio',
        facts: [
          { k: 'Scale', v: '1:20 — 1:5000', n: 'From the detail of a hotel room to a city block' },
          { k: 'Proportion', v: 'φ = 1.618', n: 'From wall to window, from plan to detail' },
          { k: 'Continuity', v: `${SITE.founded} —`, n: 'From İzmir to the Caspian shore, with the same question' },
        ],
        areas: 'Areas',
        awards: 'Awards',
        scales: 'Scales',
        scalesNote: 'From detail to city',
        cuts: 'Fragments',
        cutsNote: `Since ${SITE.founded}`,
        all: 'All works',
      };
---

<Book lang={lang} alternates={{ tr: '/', en: '/en/' }}>
  <!-- +16,00 · Pafta (kapak) -->
  <section class="poster" aria-labelledby="h-name">
    <div class="sheet">
      <svg class="sheet-grid" viewBox="0 0 1600 1000" preserveAspectRatio="none" aria-hidden="true">
        <path d={sheetGrid} fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
      </svg>
      <p class="pb b-handle">DEMİRCE®<br /><span lang="en">@DEMIRCE_NORMS</span></p>
      <p class="pb blk b1">{c.b1}</p>
      <p class="pb blk b2">{c.b2}</p>
      <p class="pb b-web">DEMİRCE®<br /><span lang="en">WWW.DEMIRCE.COM</span></p>
      <div class="mark">
        <span class="m-est">EST. {SITE.founded}</span>
        <span class="m-tag">{c.tag}</span>
        <h1 id="h-name" class="m-logo">
          <span class="sr-only">{SITE.name}</span>
          <span aria-hidden="true"><Logo variant="wordmark" /></span>
        </h1>
        <span class="m-a">{c.a}</span>
        <span class="m-b">{c.b}</span>
        <span class="m-c">{c.cc}</span>
      </div>
      <div class="pb b3">
        <p class="blk">{c.b3}</p>
        <a class="b-cta" href={worksUrl}>{c.explore} ↗</a>
      </div>
      <p class="pb blk b4">{c.b4}</p>
      <p class="pb b-coord">DEMİRCE · ALSANCAK<br />{coords}</p>
    </div>
  </section>

  <!-- +12,80 · Derinlemesine: pencereler -->
  <section class="wrap section floor" aria-labelledby="h-deep">
    <h2 id="h-deep" class="sec-head"><span class="n lv">+12,80</span><b>{c.deep}</b><span class="fill"></span><span class="note">{c.deepNote}</span></h2>
    <ol class="windows">
      {
        leads.map((l, k) => (
          <li class="win" style={`--span:${SPANS[k]}`}>
            <a href={projectUrl(l.cs.slug, lang)}>
              <span class="pane">
                <Image src={l.img} alt="" widths={[480, 800, 1200].filter((w) => w <= l.img.width)} sizes={`${Math.round((SPANS[k] / 8) * 100)}vw`} loading="lazy" />
                {l.people.map((pp) => (
                  <span class="pp" style={`left:${pp.x.toFixed(1)}%`}>
                    <Figure pose={pp.pose} mirror={pp.mirror} />
                  </span>
                ))}
                <span class="pane-q q">{l.cs.question[lang]}</span>
              </span>
              <span class="win-l">
                <span class="mono muted">{String(l.i + 1).padStart(2, '0')}</span>
                <span class="win-n">
                  <Name text={l.p.title[lang]} lang={lang} />
                </span>
                <span class="mono muted win-m">{[l.type, l.p.city?.[lang], l.p.year].filter(Boolean).join(' · ')}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- +9,60 · Ofis: Vitruvius -->
  <section class="wrap section office" aria-labelledby="h-office">
    <h2 id="h-office" class="sec-head"><span class="n lv">+9,60</span><b>{c.officeH}</b><span class="fill"></span><span class="note">{SITE.founded} —</span></h2>
    <div class="o-grid">
      <div class="o-text">
        <p class="o-big">{c.officeText}</p>
        <a class="arrow-link" href={officeUrl}>{c.about}</a>
      </div>
      <Vitruvius class="o-vit" label={c.vitruvius} />
      <dl class="o-facts">
        {
          c.facts.map((f) => (
            <div>
              <dt class="label muted">{f.k}</dt>
              <dd class="display fv" style={f.v.includes('φ') ? 'text-transform:none' : undefined}>{f.v}</dd>
              <dd class="small muted">{f.n}</dd>
            </div>
          ))
        }
        <div>
          <dt class="label muted">{c.areas}</dt>
          <dd class="small">{services.map((s) => s.title[lang]).join(' · ')}</dd>
        </div>
        <div>
          <dt class="label muted">{c.awards}</dt>
          {
            awards.map((a) => (
              <dd class="small">
                <span class="mono muted">{a.year}</span> {a.title[lang]}
              </dd>
            ))
          }
        </div>
      </dl>
    </div>
  </section>

  <!-- +6,40 · Ölçekler -->
  <section class="night section" aria-labelledby="h-scales">
    <div class="wrap">
      <h2 id="h-scales" class="sec-head"><span class="n lv">+6,40</span><b>{c.scales}</b><span class="fill"></span><span class="note">{c.scalesNote}</span></h2>
      <Scales lang={lang} />
    </div>
  </section>

  <!-- +3,20 · Kesitler -->
  <section class="wrap section cuts" aria-labelledby="h-cuts">
    <h2 id="h-cuts" class="sec-head"><span class="n lv">+3,20</span><b>{c.cuts}</b><span class="fill"></span><span class="note">{c.cutsNote}</span></h2>
    <p class="index-run">
      {
        index.map((e, k) => (
          <>
            {e.slug ? (
              <a href={projectUrl(e.slug, lang)}>
                <Name text={e.name[lang]} lang={lang} />
              </a>
            ) : (
              <span>
                <Name text={e.name[lang]} lang={lang} />
              </span>
            )}
            {k < index.length - 1 && <span class="sep"> / </span>}
          </>
        ))
      }
    </p>
    <div class="grid13">
      {
        works.map((w, k) => (
          <a class="gc gc-work" style={boxVars(packD.pos[k], packM.pos[k])} href={projectUrl(w.p.slug, lang)}>
            <img src={w.src} alt="" loading="lazy" decoding="async" />
            <span class="gc-n mono">
              <Name text={w.p.title[lang]} lang={lang} />
            </span>
          </a>
        ))
      }
      {packD.deco.map((d) => <span class={`gc gc-${d.kind} only-d`} style={`--x:${d.x};--y:${d.y};--c:${d.c};--r:${d.r}`} aria-hidden="true" />)}
      {packM.deco.map((d) => <span class={`gc gc-${d.kind} only-m`} style={`--mx:${d.x};--my:${d.y};--mc:${d.c};--mr:${d.r}`} aria-hidden="true" />)}
    </div>
    <p class="cuts-more"><a class="arrow-link" href={`${worksUrl}#dizin`}>{c.all}</a></p>
  </section>
</Book>

<style>
  /* ---------- Pafta (kapak) ---------- */
  .poster {
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 620px;
    overflow: hidden;
  }
  .sheet {
    position: absolute;
    inset: -6% -4%;
    background-color: var(--paper);
    background-image: var(--linen);
    transform: rotate(-2.4deg);
    transform-origin: 50% 50%;
  }
  .sheet-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgb(0 0 0 / 0.3);
  }
  .pb {
    position: absolute;
    margin: 0;
    font-size: var(--t-s);
    font-weight: 500;
    line-height: 1.45;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .b-handle {
    left: 27%;
    top: 9%;
  }
  .b1 {
    left: 6%;
    top: 24%;
    width: 17ch;
  }
  .b2 {
    left: 52%;
    top: 29%;
    width: 19ch;
  }
  .b-web {
    left: 85%;
    top: 34%;
  }
  .b3 {
    left: 12%;
    top: 72%;
    width: 22ch;
  }
  .b3 .blk {
    margin: 0 0 18px;
  }
  .b-cta {
    display: inline-block;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .b4 {
    left: 74%;
    top: 79%;
    width: 21ch;
  }
  .b-coord {
    left: 38%;
    top: 91%;
  }
  .mark {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(46%, 700px);
    transform: translate(-50%, -50%);
  }
  .m-logo {
    margin: 0;
    line-height: 0;
  }
  .m-logo :global(.logo) {
    width: 100%;
    height: auto;
  }
  .mark > span {
    position: absolute;
    font-size: var(--t-s);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .m-est {
    left: 0;
    bottom: calc(100% + 10px);
  }
  .m-tag {
    right: 0;
    bottom: calc(100% + 14px);
  }
  .m-a {
    left: 1%;
    top: calc(100% + 10px);
  }
  .m-b {
    left: 46%;
    top: calc(100% + 6px);
  }
  .m-c {
    right: 0;
    top: calc(100% + 2px);
  }
  @media (max-width: 860px) {
    .poster {
      height: auto;
      min-height: 0;
      overflow: hidden;
    }
    .sheet {
      position: relative;
      inset: auto;
      transform: rotate(-2deg);
      margin: 24px -8% 40px;
      padding: 40px calc(8% + var(--gutter) + 8px) 48px;
      display: flex;
      flex-direction: column;
      gap: 34px;
    }
    .pb,
    .mark {
      position: relative;
      left: auto;
      top: auto;
      right: auto;
      transform: none;
    }
    .mark {
      width: 100%;
      margin: 42px 0 52px;
    }
    .b2,
    .b4,
    .b-web {
      align-self: flex-end;
    }
    .m-b {
      left: 40%;
    }
  }

  /* ---------- +12,80 Pencereler ---------- */
  .windows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 44px) clamp(10px, 1.2vw, 18px);
  }
  .win {
    grid-column: span var(--span);
  }
  .win a {
    display: grid;
    gap: 12px;
    text-decoration: none;
  }
  .pane {
    position: relative;
    display: block;
    height: clamp(200px, 22vw, 340px);
    background: #121212;
    overflow: hidden;
    border-bottom: 6px solid var(--ink);
  }
  .pane :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
    transition:
      opacity 0.9s var(--ease),
      transform 1.6s var(--ease);
  }
  .pp {
    position: absolute;
    bottom: 0;
    height: 26%;
    color: #ecebe6;
    transition: opacity 0.6s;
  }
  .pane-q {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 14px;
    font-size: clamp(1.05rem, 0.8rem + 0.6vw, 1.45rem);
    line-height: 1.08;
    color: #ecebe6;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.5s,
      transform 0.6s var(--ease);
  }
  .win a:hover .pane :global(img),
  .win a:focus-visible .pane :global(img) {
    opacity: 0.95;
    transform: scale(1.02);
  }
  .win a:hover .pp {
    opacity: 0;
  }
  .win a:hover .pane-q,
  .win a:focus-visible .pane-q {
    opacity: 1;
    transform: none;
  }
  .win-l {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    align-items: baseline;
  }
  .win-n {
    font-family: var(--display);
    font-stretch: 68%;
    font-weight: 560;
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.75rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .win-m {
    grid-column: 2;
    text-transform: uppercase;
  }
  @media (hover: none) {
    .pane :global(img) {
