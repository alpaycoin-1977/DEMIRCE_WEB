---
/*
 * KVKK AYDINLATMA METNİ — şablon niteliğindedir.
 * Yayına almadan önce hukuk danışmanınızla gözden geçirin ve
 * ofisin gerçek veri işleme süreçlerine göre güncelleyin.
 */
import Base from '~/layouts/Base.astro';
import PrivacyContent from '~/components/PrivacyContent.astro';
import { formatDate, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const updated = formatDate(new Date('2026-11-23'), lang);
---

<Base lang={lang} title={lang === 'tr' ? 'KVKK Aydınlatma Metni ve Gizlilik' : 'Privacy Notice'} route="privacy" sheet="A-90">
  <div class="wrap page-head">
    <p class="label muted"><span class="accent">A-90 — </span>{lang === 'tr' ? 'Son güncelleme' : 'Last updated'}: {updated}</p>
    <h1 class="display">{lang === 'tr' ? 'KVKK & Gizlilik' : 'Privacy'}</h1>
  </div>
  <div class="wrap">
    <PrivacyContent lang={lang} />
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 120px) clamp(24px, 3vw, 40px);
  }
  .page-head h1 {
    font-size: var(--step-5);
    margin-top: 18px;
  }
  .wrap :global(.prose) {
    font-size: var(--step-1);
  }
</style>
