---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import JournalCard from '~/components/JournalCard.astro';
import Icon from '~/components/Icon.astro';
import { getProject } from '~/data/projects';
import { projectCover } from '~/lib/images';
import { ROUTES, t, postUrl, projectUrl, formatDate, type Lang } from '~/i18n/ui';
import { brandSafe } from '~/lib/text';

interface Props {
  post: CollectionEntry<'journal'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const tr = t(lang);
const slug = post.id.split('/')[1];
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 200));
const project = post.data.project ? getProject(post.data.project) : undefined;
const all = (await getCollection('journal', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const idx = all.findIndex((p) => p.id === post.id);
const others = all.filter((p) => p.id !== post.id).slice(Math.max(0, idx - 1), Math.max(0, idx - 1) + 3);
const ld = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang,
  author: { '@id': 'https://www.demirce.com/#ofis' },
  publisher: { '@id': 'https://www.demirce.com/#ofis' },
  mainEntityOfPage: new URL(postUrl(slug, lang), Astro.site).href,
};
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternates={{ tr: postUrl(slug, 'tr'), en: postUrl(slug, 'en') }}
  image={post.data.cover ?? (project ? projectCover(project.slug) : undefined)}
  imageAlt={post.data.coverAlt}
  type="article"
  published={post.data.date}
  sheet="A-61"
  jsonLd={[ld]}
>
  <article class="post">
    <header class="wrap post-head">
      <nav class="mono muted crumbs" aria-label={lang === 'tr' ? 'Sayfa yolu' : 'Breadcrumb'}>
        <a href={ROUTES.journal[lang]}>{tr('nav.journal')}</a> / <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time> · {minutes} {tr('common.minRead')}
      </nav>
      <h1 class="display" set:html={brandSafe(post.data.title, lang)} />
      <p class="lead">{post.data.description}</p>
      {post.data.tags.length > 0 && <ul class="tags">{post.data.tags.map((tg) => <li class="chip">{tg}</li>)}</ul>}
    </header>
    {
      post.data.cover && (
        <figure class="wrap post-cover">
          <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[640, 960, 1400]} sizes="(min-width: 1100px) 1000px, 100vw" loading="eager" />
          {post.data.coverAlt && <figcaption class="mono muted">{post.data.coverAlt}</figcaption>}
        </figure>
      )
    }
    <div class="wrap post-body">
      <div class="prose">
        <Content />
      </div>
      <aside class="post-aside">
        {
          project && (
            <a class="proj crop" href={projectUrl(project.slug, lang)} style={`--pc:${project.color}`}>
              <Image src={projectCover(project.slug)} alt="" widths={[320, 640]} sizes="320px" loading="lazy" />
              <span class="label muted">{tr('nav.projects')}</span>
              <span class="display" set:html={brandSafe(project.title[lang], lang)} />
              <span class="link-arrow">
                {tr('common.viewProject')} <Icon name="arrow-right" size={16} />
              </span>
            </a>
          )
        }
        <button type="button" class="btn btn--ghost" data-share data-copied={tr('common.copied')}><Icon name="share" size={16} />{tr('common.share')}</button>
      </aside>
    </div>
  </article>
  <section class="wrap more" aria-labelledby="diger-yazilar">
    <h2 id="diger-yazilar" class="label">{tr('nav.journal')}</h2>
    <div class="grid">{others.map((p) => <JournalCard post={p} lang={lang} />)}</div>
  </section>
</Base>

<style>
  .post-head {
    padding-block: clamp(40px, 7vw, 100px) clamp(24px, 3vw, 40px);
    max-width: 1200px;
  }
  .crumbs a {
    text-decoration: none;
  }
  .post-head h1 {
    font-size: var(--step-4);
    margin: 20px 0 24px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
  }
  .post-cover {
    margin: 0 auto;
    max-width: 1200px;
  }
  .post-cover :global(img) {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
    background: var(--paper-2);
  }
  .post-cover figcaption {
    margin-top: 10px;
  }
  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(40px, 6vw, 80px);
    max-width: 1200px;
  }
  .prose {
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .post-aside {
    display: grid;
    gap: 16px;
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    align-self: start;
  }
  .proj {
    display: grid;
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--line-strong);
    border-top: 4px solid var(--pc);
    text-decoration: none;
  }
  .proj :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .proj .display {
    font-size: var(--step-2);
  }
  .more h2 {
    padding-bottom: 14px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px);
  }
  @media (max-width: 900px) {
    .post-body,
    .grid {
      grid-template-columns: 1fr;
    }
    .post-aside {
      position: static;
    }
  }
</style>
