---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import JournalCard from '~/components/JournalCard.astro';
import Icon from '~/components/Icon.astro';
import type { Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const posts = (await getCollection('journal', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const byYear = posts.reduce<Record<number, typeof posts>>((acc, p) => {
  const y = p.data.date.getFullYear();
  (acc[y] ||= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
const c =
  lang === 'tr'
    ? { title: 'Günlük', lead: 'Ödüller, şantiyeler, sergiler, söyleşiler ve mimarlık üzerine notlar.', rss: 'RSS ile takip et' }
    : { title: 'Journal', lead: 'Awards, sites, exhibitions, talks and notes on architecture.', rss: 'Follow via RSS' };
---

<Base lang={lang} title={c.title} description={c.lead} route="journal" sheet="A-60">
  <div class="wrap page-head">
    <p class="label muted"><span class="accent">A-60 — </span>{posts.length} {lang === 'tr' ? 'yazı' : 'posts'}</p>
    <h1 class="display">{c.title}</h1>
    <div class="head-row">
      <p class="lead">{c.lead}</p>
      <a class="link-arrow" href={lang === 'tr' ? '/rss.xml' : '/en/rss.xml'}>{c.rss} <Icon name="arrow-up-right" size={16} /></a>
    </div>
    <nav class="years" aria-label={lang === 'tr' ? 'Yıllar' : 'Years'}>
      {years.map((y) => <a class="chip" href={`#y${y}`}>{y}</a>)}
    </nav>
  </div>
  <div class="wrap">
    {
      years.map((y) => (
        <section class="year" id={`y${y}`} aria-labelledby={`yh${y}`}>
          <h2 id={`yh${y}`} class="display year-h">{y}</h2>
          <div class="grid">
            {byYear[y].map((p) => (
              <JournalCard post={p} lang={lang} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 120px) clamp(32px, 4vw, 56px);
  }
  .page-head h1 {
    font-size: var(--step-5);
    margin: 18px 0 24px;
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 32px;
  }
  .year {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: clamp(20px, 4vw, 64px);
    padding-block: clamp(32px, 5vw, 64px);
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .year-h {
    font-size: var(--step-4);
    position: sticky;
    top: calc(var(--header-h) + 20px);
    align-self: start;
    color: var(--ink-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px);
  }
  @media (max-width: 1000px) {
    .year {
      grid-template-columns: 1fr;
    }
    .year-h {
      position: static;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
