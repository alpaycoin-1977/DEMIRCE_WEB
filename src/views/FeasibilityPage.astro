---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { ROUTES, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c =
  lang === 'tr'
    ? {
        title: 'Arsa Potansiyeli',
        sub: 'Fizibilite hesaplayıcı',
        lead: 'İmar durumunuzdaki birkaç değeri girin; arsanızın inşaat alanını, kat adedini ve kapasitesini anında görün. Sonucu tek tıkla ofisimize gönderin.',
        type: 'Proje tipi',
        types: { konut: 'Konut / Rezidans', otel: 'Otel', karma: 'Karma kullanım', ofis: 'Ofis', egitim: 'Eğitim' },
        area: 'Arsa alanı (m²)',
        far: 'Emsal (KAKS)',
        tac: 'TAKS',
        hmax: 'Kat sınırı (isteğe bağlı)',
        extra: 'Emsal dışı alan varsayımı',
        extraHint: 'Otopark, sığınak, teknik hacimler vb.',
        unit: 'Ortalama daire büyüklüğü (net)',
        units: [
          ['60', '1+1 · ≈60 m²'],
          ['95', '2+1 · ≈95 m²'],
          ['135', '3+1 · ≈135 m²'],
          ['180', '4+1 · ≈180 m²'],
        ],
        key: 'Otel tipi (brüt m² / oda)',
        keys: [
          ['45', 'Şehir oteli · ≈45 m²'],
          ['60', 'Butik / 4★ · ≈60 m²'],
          ['85', 'Resort / 5★ · ≈85 m²'],
        ],
        retail: 'Ticari alan oranı',
        results: 'Sonuçlar',
        rE: 'Emsale esas inşaat alanı',
        rT: 'Maks. taban oturumu',
        rF: 'Tahmini kat adedi',
        rH: 'Yaklaşık yükseklik',
        rTotal: 'Toplam inşaat alanı (≈)',
        rOpen: 'Açık alan (≈)',
        rCap: 'Tahmini kapasite',
        warnH: 'Kat sınırı nedeniyle emsalin tamamı kullanılamayabilir.',
        send: 'Sonucu ofise gönder',
        copy: 'Bağlantıyı kopyala',
        print: 'Yazdır / PDF',
        copied: 'Bağlantı kopyalandı',
        disclaimer:
          'Bu hesaplayıcı yalnızca ön fikir vermek içindir. Kesin değerler; imar durumu belgesi, plan notları, Planlı Alanlar İmar Yönetmeliği, yerel yönetmelikler, çekme mesafeleri ve arsanın gerçek verileriyle yapılacak bir çalışmayla belirlenir.',
        capUnits: 'daire',
        capKeys: 'oda',
        capPeople: 'kişilik çalışma alanı',
        capRetail: 'ticari',
        capEdu: 'Kapasite, eğitim programı çalışmasıyla belirlenir.',
        floorsUnit: 'kat',
        massing: 'Kütle önizlemesi',
        briefTitle: '— DEMİRCE Arsa Potansiyeli Hesaplayıcı —',
      }
    : {
        title: 'Site Potential',
        sub: 'Feasibility calculator',
        lead: 'Enter a few values from your zoning certificate to instantly see buildable area, storeys and capacity. Send the result to our studio in one click.',
        type: 'Project type',
        types: { konut: 'Residential', otel: 'Hotel', karma: 'Mixed-use', ofis: 'Office', egitim: 'Education' },
        area: 'Site area (m²)',
        far: 'Floor area ratio (FAR / KAKS)',
        tac: 'Site coverage (TAKS)',
        hmax: 'Storey limit (optional)',
        extra: 'Non-FAR area assumption',
        extraHint: 'Parking, shelters, plant rooms, etc.',
        unit: 'Average unit size (net)',
        units: [
          ['60', '1-bed · ≈60 m²'],
          ['95', '2-bed · ≈95 m²'],
          ['135', '3-bed · ≈135 m²'],
          ['180', '4-bed · ≈180 m²'],
        ],
        key: 'Hotel type (gross m² / key)',
        keys: [
          ['45', 'City hotel · ≈45 m²'],
          ['60', 'Boutique / 4★ · ≈60 m²'],
          ['85', 'Resort / 5★ · ≈85 m²'],
        ],
        retail: 'Retail share',
        results: 'Results',
        rE: 'FAR floor area',
        rT: 'Max. footprint',
        rF: 'Estimated storeys',
        rH: 'Approx. height',
        rTotal: 'Total construction area (≈)',
        rOpen: 'Open ground (≈)',
        rCap: 'Estimated capacity',
        warnH: 'The storey limit may prevent using the full FAR.',
        send: 'Send result to the studio',
        copy: 'Copy link',
        print: 'Print / PDF',
        copied: 'Link copied',
        disclaimer:
          'This calculator gives a first indication only. Definitive figures depend on the zoning certificate, plan notes, national and local regulations, setbacks and real site data.',
        capUnits: 'units',
        capKeys: 'keys',
        capPeople: 'workstations',
        capRetail: 'retail',
        capEdu: 'Capacity is defined through an educational brief.',
        floorsUnit: 'storeys',
        massing: 'Massing preview',
        briefTitle: '— DEMİRCE Site Potential Calculator —',
      };
---

<Base lang={lang} title={c.title} description={c.lead} route="feasibility" sheet="A-40">
  <div class="wrap page-head">
    <p class="label muted"><span class="accent">A-40 — </span>{c.sub}</p>
    <h1 class="display">{c.title}</h1>
    <p class="lead">{c.lead}</p>
  </div>

  <div class="wrap calc" data-calc data-l={JSON.stringify(c)} data-lang={lang} data-contact={ROUTES.contact[lang]}>
    <form class="inputs" data-calc-form onsubmit="return false">
      <fieldset class="types">
        <legend class="label">{c.type}</legend>
        {
          Object.entries(c.types).map(([k, v], i) => (
            <label class="type">
              <input type="radio" name="type" value={k} checked={i === 0} />
              <span>{v}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="field">
        <label for="c-area">{c.area}</label>
        <div class="dual">
          <input id="c-area" name="area" type="number" min="100" max="500000" step="10" value="2500" inputmode="numeric" />
          <input type="range" min="200" max="50000" step="50" value="2500" data-mirror="area" aria-label={c.area} />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="c-far">{c.far}</label>
          <input id="c-far" name="far" type="number" min="0.05" max="10" step="0.05" value="1.50" inputmode="decimal" />
        </div>
        <div class="field">
          <label for="c-tac">{c.tac}</label>
          <input id="c-tac" name="tac" type="number" min="0.05" max="1" step="0.05" value="0.35" inputmode="decimal" />
        </div>
        <div class="field">
          <label for="c-hmax">{c.hmax}</label>
          <input id="c-hmax" name="hmax" type="number" min="1" max="80" step="1" placeholder="—" inputmode="numeric" />
        </div>
      </div>
      <div class="field">
        <label for="c-extra">{c.extra}: <output data-out="extra">30</output>%</label>
        <input id="c-extra" name="extra" type="range" min="0" max="60" step="5" value="30" />
        <span class="mono muted hint">{c.extraHint}</span>
      </div>
      <div class="field" data-show="konut karma">
        <label for="c-unit">{c.unit}</label>
        <select id="c-unit" name="unit">{c.units.map(([v, l], i) => <option value={v} selected={i === 1}>{l}</option>)}</select>
      </div>
      <div class="field" data-show="otel" hidden>
        <label for="c-key">{c.key}</label>
        <select id="c-key" name="key">{c.keys.map(([v, l], i) => <option value={v} selected={i === 1}>{l}</option>)}</select>
      </div>
      <div class="field" data-show="karma" hidden>
        <label for="c-retail">{c.retail}: <output data-out="retail">30</output>%</label>
        <input id="c-retail" name="retail" type="range" min="10" max="80" step="5" value="30" />
      </div>
      <p class="disclaimer mono muted">{c.disclaimer}</p>
    </form>

    <section class="results" aria-labelledby="sonuc">
      <h2 id="sonuc" class="label">{c.results}</h2>
      <div class="massing" aria-label={c.massing} role="img" data-massing></div>
      <dl class="rlist" aria-live="polite">
        <div class="hero-r"><dt>{c.rE}</dt><dd data-r="E">—</dd></div>
        <div><dt>{c.rF}</dt><dd data-r="F">—</dd></div>
        <div><dt>{c.rT}</dt><dd data-r="T">—</dd></div>
        <div><dt>{c.rH}</dt><dd data-r="H">—</dd></div>
        <div><dt>{c.rTotal}</dt><dd data-r="Total">—</dd></div>
        <div><dt>{c.rOpen}</dt><dd data-r="Open">—</dd></div>
        <div class="hero-r cap"><dt>{c.rCap}</dt><dd data-r="Cap">—</dd></div>
      </dl>
      <p class="warn mono" data-warn hidden>⚠ {c.warnH}</p>
      <div class="actions no-print">
        <button type="button" class="btn btn--accent" data-send>{c.send} <Icon name="arrow-right" /></button>
        <button type="button" class="btn btn--ghost" data-copy><Icon name="share" size={16} />{c.copy}</button>
        <button type="button" class="btn btn--ghost" data-print><Icon name="download" size={16} />{c.print}</button>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 120px) clamp(32px, 4vw, 56px);
  }
  .page-head h1 {
    font-size: var(--step-5);
    margin: 18px 0 24px;
  }
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .inputs {
    display: grid;
    gap: 22px;
  }
  .types {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .types legend {
    margin-bottom: 10px;
    color: var(--ink-2);
  }
  .type input {
    position: absolute;
    opacity: 0;
  }
  .type span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid var(--line-strong);
    cursor: pointer;
    font-size: var(--step--1);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .type input:checked + span {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .type input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .dual {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 16px;
    align-items: center;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .hint {
    font-size: 0.68rem;
  }
  .disclaimer {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.72rem;
    line-height: 1.6;
    border-left: 2px solid var(--line-strong);
    padding-left: 12px;
  }
  .results {
    position: sticky;
    top: calc(var(--header-h) + 20px);
    border: 1px solid var(--line-strong);
    padding: clamp(16px, 2.5vw, 28px);
    background: var(--paper);
  }
  .results h2 {
    margin: 0 0 12px;
  }
  .massing {
    height: 260px;
    border: 1px solid var(--line);
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 20px 20px;
    margin-bottom: 16px;
  }
  .massing :global(svg) {
    width: 100%;
    height: 100%;
  }
  .rlist {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .rlist > div {
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .rlist .hero-r {
    grid-column: 1 / -1;
  }
  .rlist dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .rlist dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-stretch: 75%;
    font-size: var(--step-2);
    line-height: 1.05;
  }
  .rlist .hero-r dd {
    font-size: var(--step-4);
    font-stretch: 62.5%;
  }
  .rlist .cap dd {
    color: var(--accent-text);
  }
  .warn {
    color: var(--accent-text);
    font-size: var(--step--1);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  @media (max-width: 1000px) {
    .calc {
      grid-template-columns: 1fr;
    }
    .results {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .row,
    .dual {
      grid-template-columns: 1fr;
    }
  }
  @media print {
    .inputs .types,
    .inputs input[type='range'] {
      display: none;
    }
    .calc {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { toast } from '~/scripts/ui';
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const L = JSON.parse(root.dataset.l || '{}');
    const lang = root.dataset.lang as 'tr' | 'en';
    const form = root.querySelector<HTMLFormElement>('[data-calc-form]')!;
    const nf = new Intl.NumberFormat(lang === 'tr' ? 'tr-TR' : 'en-GB', { maximumFractionDigits: 0 });
    const nf2 = new Intl.NumberFormat(lang === 'tr' ? 'tr-TR' : 'en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const num = (name: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      const v = parseFloat((el?.value || '').replace(',', '.'));
      return Number.isFinite(v) ? v : NaN;
    };
    const m2 = (v: number) => `${nf.format(Math.round(v))} m²`;

    // URL'den başlangıç değerleri (paylaşılabilir hesap)
    const qp = new URLSearchParams(location.search);
    ['area', 'far', 'tac', 'hmax', 'extra', 'unit', 'key', 'retail'].forEach((k) => {
      const v = qp.get(k);
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (v && el) el.value = v;
    });
    const tq = qp.get('type');
    if (tq) form.querySelectorAll<HTMLInputElement>('[name="type"]').forEach((r) => (r.checked = r.value === tq));

    const iso = (x: number, y: number, z: number, s: number, ox: number, oy: number) => [ox + (x - y) * 0.866 * s, oy + (x + y) * 0.5 * s - z * s];
    const drawMassing = (A: number, T: number, floors: number, fh: number) => {
      const site = Math.sqrt(A);
      const bw = Math.sqrt(T * 1.6);
      const bd = T / bw;
      const H = floors * fh;
      const W = 400;
      const Hh = 260;
      // ölçek: arsa + bina yüksekliği sığsın
      const s = Math.min((W - 40) / (site * 1.732), (Hh - 30) / (site * 1 + H));
      const ox = W / 2;
      const oy = Hh - 12 - (site * s) / 2;
      const P = (x: number, y: number, z: number) => iso(x - site / 2, y - site / 2, z, s, ox, oy).map((n) => n.toFixed(1)).join(',');
      const x0 = (site - bw) / 2;
      const y0 = (site - bd) / 2;
      const x1 = x0 + bw;
      const y1 = y0 + bd;
      let svg = `<svg viewBox="0 0 ${W} ${Hh}" xmlns="http://www.w3.org/2000/svg">`;
      svg += `<polygon points="${P(0, 0, 0)} ${P(site, 0, 0)} ${P(site, site, 0)} ${P(0, site, 0)}" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-dasharray="4 4"/>`;
      // gölge yönü: güneybatıdan ışık → kuzeydoğuya gölge
      svg += `<polygon points="${P(x0, y0, 0)} ${P(x1, y0, 0)} ${P(x1 + H * 0.35, y0 - H * 0.2, 0)} ${P(x0 + H * 0.35, y0 - H * 0.2, 0)}" fill="currentColor" fill-opacity=".07"/>`;
      svg += `<polygon points="${P(x0, y1, 0)} ${P(x1, y1, 0)} ${P(x1, y1, H)} ${P(x0, y1, H)}" fill="var(--paper-2)" stroke="currentColor" stroke-width="1"/>`;
      svg += `<polygon points="${P(x1, y0, 0)} ${P(x1, y1, 0)} ${P(x1, y1, H)} ${P(x1, y0, H)}" fill="var(--paper-3)" stroke="currentColor" stroke-width="1"/>`;
      svg += `<polygon points="${P(x0, y0, H)} ${P(x1, y0, H)} ${P(x1, y1, H)} ${P(x0, y1, H)}" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>`;
      const step = floors > 40 ? Math.ceil(floors / 40) : 1;
      for (let f = step; f < floors; f += step) {
        const z = f * fh;
        svg += `<polyline points="${P(x0, y1, z)} ${P(x1, y1, z)} ${P(x1, y0, z)}" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width=".6"/>`;
      }
      svg += `<text x="${W - 10}" y="18" text-anchor="end" font-family="monospace" font-size="11" fill="currentColor">${floors} ${L.floorsUnit} · ${nf.format(H)} m</text>`;
      svg += `<text x="10" y="${Hh - 8}" font-family="monospace" font-size="10" fill="currentColor" opacity=".6">${nf.format(A)} m²</text>`;
      svg += `</svg>`;
      $<HTMLElement>('[data-massing]').innerHTML = svg;
    };

    let brief = '';
    const calc = () => {
      const type = (form.querySelector<HTMLInputElement>('[name="type"]:checked')?.value || 'konut') as string;
      root.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => (el.hidden = !el.dataset.show!.split(' ').includes(type)));
      const A = Math.max(0, num('area'));
      const far = Math.max(0, num('far'));
      const tac = Math.min(1, Math.max(0.01, num('tac')));
      const hmax = num('hmax');
      const extra = num('extra') / 100;
      $<HTMLOutputElement>('[data-out="extra"]').textContent = String(Math.round(extra * 100));
      $<HTMLOutputElement>('[data-out="retail"]').textContent = String(num('retail'));
      const mirror = root.querySelector<HTMLInputElement>('[data-mirror="area"]');
      if (mirror && document.activeElement !== mirror) mirror.value = String(Math.min(50000, A));
      if (!A || !far) return;
      const E = A * far;
      const T = A * tac;
      let floors = Math.max(1, Math.ceil(E / T - 1e-9));
      let Euse = E;
      const limited = Number.isFinite(hmax) && hmax > 0 && floors > hmax;
      if (limited) {
        floors = hmax;
        Euse = Math.min(E, T * hmax);
      }
      $<HTMLElement>('[data-warn]').hidden = !limited;
      const fh = type === 'otel' || type === 'ofis' ? 3.6 : type === 'egitim' ? 4 : type === 'karma' ? 3.4 : 3.2;
      const total = Euse * (1 + extra);
      const open = Math.max(0, A - T);
      const range = (v: number) => `${nf.format(Math.floor(v * 0.9))}–${nf.format(Math.ceil(v * 1.1))}`;
      let cap = '';
      if (type === 'konut') cap = `${range((Euse * 0.78) / num('unit'))} ${L.capUnits}`;
      else if (type === 'otel') cap = `${range(Euse / num('key'))} ${L.capKeys}`;
      else if (type === 'ofis') cap = `${range((Euse * 0.8) / 10)} ${L.capPeople}`;
      else if (type === 'karma') {
        const r = num('retail') / 100;
        cap = `${m2(Euse * r)} ${L.capRetail} + ${range((Euse * (1 - r) * 0.78) / num('unit'))} ${L.capUnits}`;
      } else cap = L.capEdu;
      const set = (k: string, v: string) => ($<HTMLElement>(`[data-r="${k}"]`).textContent = v);
      set('E', m2(Euse));
      set('T', m2(T));
      set('F', `${floors} ${L.floorsUnit}`);
      set('H', `≈ ${nf.format(floors * fh)} m`);
      set('Total', m2(total));
      set('Open', m2(open));
      set('Cap', cap);
      drawMassing(A, T, floors, fh);

      // Paylaşılabilir URL
      const u = new URL(location.href);
      u.search = '';
      u.searchParams.set('type', type);
      ['area', 'far', 'tac', 'hmax', 'extra', 'unit', 'key', 'retail'].forEach((k) => {
        const v = (form.elements.namedItem(k) as HTMLInputElement)?.value;
        if (v) u.searchParams.set(k, v);
      });
      history.replaceState(null, '', u);
      brief = [
        L.briefTitle,
        `${L.type}: ${L.types[type]}`,
        `${L.area}: ${nf.format(A)} · ${L.far}: ${nf2.format(far)} · ${L.tac}: ${nf2.format(tac)}${limited ? ` · ${L.hmax}: ${hmax}` : ''}`,
        `${L.rE}: ${m2(Euse)}`,
        `${L.rF}: ${floors}`,
        `${L.rTotal}: ${m2(total)}`,
        `${L.rCap}: ${cap}`,
        u.href,
      ].join('\n');
    };
    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.dataset.mirror) (form.elements.namedItem(t.dataset.mirror) as HTMLInputElement).value = t.value;
      calc();
    });
    calc();

    $('[data-send]').addEventListener('click', () => {
      try {
        sessionStorage.setItem('demirce-brief', brief);
      } catch {}
      location.href = `${root.dataset.contact}?ref=fizibilite`;
    });
    $('[data-copy]').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        toast(L.copied);
      } catch {}
    });
    $('[data-print]').addEventListener('click', () => print());
  }
</script>
