---
import Book from '~/layouts/Book.astro';
import PageHead from '~/components/PageHead.astro';
import PrivacyContent from '~/components/PrivacyContent.astro';
import type { Lang } from '~/i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Book lang={lang} title={lang === 'tr' ? 'KVKK' : 'Privacy'} alternates={{ tr: '/kvkk/', en: '/en/privacy/' }}>
  <PageHead
    n="§"
    label={lang === 'tr' ? 'KVKK' : 'Privacy'}
    title={lang === 'tr' ? 'KVKK ve gizlilik' : 'Privacy'}
    lead={lang === 'tr' ? 'Bu site çerez kullanmaz ve tarayıcınızda hiçbir şey saklamaz.' : 'This site uses no cookies and stores nothing in your browser.'}
    seed="kvkk"
    threshold={0.62}
  />
  <div class="wrap">
    <PrivacyContent lang={lang} />
  </div>
</Book>
