---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { SITE } from '~/data/site';
import { ROUTES, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c =
  lang === 'tr'
    ? {
        title: 'İletişim',
        lead: 'Bir fikir, bir arsa ya da yalnızca bir soru — bize yazın, en kısa sürede dönelim.',
        name: 'Ad Soyad',
        email: 'E-posta',
        phone: 'Telefon (isteğe bağlı)',
        subject: 'Konu',
        subjects: ['Yeni proje', 'İç mimari', 'Fizibilite / arsa değerlendirmesi', 'Basın', 'Kariyer', 'Diğer'],
        message: 'Mesajınız',
        board: 'İlham panomu mesaja ekle',
        consent: 'Kişisel verilerimin talebimi yanıtlamak amacıyla işlenmesine ilişkin',
        consentLink: 'aydınlatma metnini',
        consentEnd: 'okudum.',
        send: 'Gönder',
        sending: 'Gönderiliyor…',
        ok: 'Teşekkürler! Mesajınız bize ulaştı.',
        fallback: 'Sunucuya ulaşılamadı; mesajınızı e-posta uygulamanızla gönderebilmeniz için taslak açılıyor.',
        required: 'zorunlu',
        office: 'Ofis',
        directions: 'Yol tarifi al',
        nowAt: 'Alsancak’ta şimdi',
        brief: 'Fizibilite sonucunuz mesaja eklendi.',
      }
    : {
        title: 'Contact',
        lead: 'An idea, a site or simply a question — write to us and we will get back to you soon.',
        name: 'Full name',
        email: 'Email',
        phone: 'Phone (optional)',
        subject: 'Subject',
        subjects: ['New project', 'Interior design', 'Feasibility / site review', 'Press', 'Careers', 'Other'],
        message: 'Your message',
        board: 'Attach my mood board',
        consent: 'I have read the',
        consentLink: 'privacy notice',
        consentEnd: 'on how my data is processed to answer my request.',
        send: 'Send',
        sending: 'Sending…',
        ok: 'Thank you! Your message has reached us.',
        fallback: 'We could not reach the server; opening a draft in your email app instead.',
        required: 'required',
        office: 'Studio',
        directions: 'Get directions',
        nowAt: 'In Alsancak now',
        brief: 'Your feasibility result has been added to the message.',
      };
const ld = {
  '@type': 'ContactPage',
  name: c.title,
  url: new URL(ROUTES.contact[lang], Astro.site).href,
  mainEntity: { '@id': 'https://www.demirce.com/#ofis' },
};
---

<Base lang={lang} title={c.title} description={c.lead} route="contact" sheet="A-70" jsonLd={[ld]}>
  <div class="wrap page-head">
    <p class="label muted"><span class="accent">A-70 — </span>Alsancak · İzmir</p>
    <h1 class="display">{c.title}</h1>
    <p class="lead">{c.lead}</p>
  </div>

  <div class="wrap contact">
    <form
      class="form"
      method="post"
      action={SITE.formEndpoint}
      novalidate
      data-contact
      data-email={SITE.email}
      data-msgs={JSON.stringify({ sending: c.sending, ok: c.ok, fallback: c.fallback, send: c.send, brief: c.brief })}
    >
      <div class="row">
        <div class="field">
          <label for="f-name">{c.name} <span class="req" aria-hidden="true">*</span></label>
          <input id="f-name" name="name" autocomplete="name" required maxlength="120" />
        </div>
        <div class="field">
          <label for="f-email">{c.email} <span class="req" aria-hidden="true">*</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="160" />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="f-phone">{c.phone}</label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
        </div>
        <div class="field">
          <label for="f-subject">{c.subject}</label>
          <select id="f-subject" name="subject">{c.subjects.map((s) => <option>{s}</option>)}</select>
        </div>
      </div>
      <div class="field">
        <label for="f-message">{c.message} <span class="req" aria-hidden="true">*</span></label>
        <textarea id="f-message" name="message" required minlength="10" maxlength="6000" rows="8"></textarea>
      </div>
      <!-- Bot tuzağı: insanlar bu alanı görmez -->
      <div class="hp" aria-hidden="true">
        <label for="f-website">Website</label>
        <input id="f-website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="board" value="" data-board-field />
      <label class="check" data-board-wrap hidden>
        <input type="checkbox" name="attach_board" data-board-check checked />
        <span>{c.board} (<span data-board-n>0</span>)</span>
      </label>
      <label class="check">
        <input type="checkbox" name="consent" required />
        <span>{c.consent} <a href={ROUTES.privacy[lang]} target="_blank">{c.consentLink}</a> {c.consentEnd}</span>
      </label>
      <div class="submit-row">
        <button type="submit" class="btn btn--accent" data-submit>{c.send} <Icon name="arrow-right" /></button>
        <p class="status mono" role="status" aria-live="polite" data-status></p>
      </div>
    </form>

    <aside class="cards">
      <div class="card">
        <p class="label muted">{c.office}</p>
        <address>
          {SITE.address.street}<br />
          {SITE.address.district} / {SITE.address.city}
        </address>
        <a class="link-arrow" href={SITE.mapsUrl} target="_blank" rel="noopener">{c.directions} <Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div class="card">
        <a class="big-link" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
        <a class="big-link" href={`mailto:${SITE.email}`}><Icon name="mail" /> {SITE.email}</a>
      </div>
      <div class="card now" data-now data-lat={SITE.geo.lat} data-lon={SITE.geo.lon} data-offset={SITE.utcOffset}>
        <p class="label muted">{c.nowAt}</p>
        <p class="display now-time" data-now-time>--:--</p>
        <p class="mono muted" data-now-sun>&nbsp;</p>
      </div>
      <div class="card social">
        <a href={SITE.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram</a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener"><Icon name="facebook" /> Facebook</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 120px) clamp(32px, 4vw, 56px);
  }
  .page-head h1 {
    font-size: var(--step-5);
    margin: 18px 0 24px;
  }
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 20px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .req {
    color: var(--accent-text);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .check input {
    margin-top: 3px;
    flex: none;
  }
  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .status {
    margin: 0;
    font-size: var(--step--1);
  }
  .status.ok {
    color: #1f8a4c;
  }
  .status.err {
    color: var(--accent-text);
  }
  .form :global(.invalid) {
    border-color: var(--accent) !important;
  }
  .cards {
    display: grid;
    gap: 16px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .card {
    padding: 20px;
    border: 1px solid var(--line-strong);
    display: grid;
    gap: 12px;
  }
  address {
    font-style: normal;
    font-size: var(--step-1);
  }
  .big-link {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--step-1);
    text-decoration: none;
  }
  .big-link:hover {
    color: var(--accent-text);
  }
  .now-time {
    font-size: var(--step-4);
    margin: 0;
  }
  .now p {
    margin: 0;
  }
  .social {
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 20px;
  }
  .social a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    text-decoration: none;
    font-size: var(--step--1);
  }
  .social a:hover {
    color: var(--accent-text);
  }
  @media (max-width: 900px) {
    .contact,
    .row {
      grid-template-columns: 1fr;
    }
    .cards {
      position: static;
    }
  }
</style>

<script>
  import { getBoard } from '~/scripts/board';
  import { sunPosition, compassBearing } from '~/lib/sun';

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const M = JSON.parse(form.dataset.msgs || '{}');
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const params = new URLSearchParams(location.search);
    const msg = form.querySelector<HTMLTextAreaElement>('[name="message"]')!;
    const subject = form.querySelector<HTMLSelectElement>('[name="subject"]')!;

    // Ön doldurma: proje sayfasından, fizibilite aracından, panodan
    const proje = params.get('proje');
    if (proje && !msg.value) msg.value = (document.documentElement.lang === 'en' ? `About: ${proje}\n\n` : `Konu: ${proje}\n\n`);
    try {
      const brief = sessionStorage.getItem('demirce-brief');
      if (brief && params.get('ref') === 'fizibilite') {
        msg.value = brief + '\n\n' + msg.value;
        subject.selectedIndex = 2;
        status.textContent = M.brief;
      }
    } catch {}
    const board = getBoard();
    if (board.length) {
      form.querySelector<HTMLElement>('[data-board-wrap]')!.hidden = false;
      form.querySelector<HTMLElement>('[data-board-n]')!.textContent = String(board.length);
      const check = form.querySelector<HTMLInputElement>('[data-board-check]')!;
      if (params.get('pano') === '1') check.checked = true;
    }

    const boardText = () => {
      const check = form.querySelector<HTMLInputElement>('[data-board-check]');
      if (!board.length || !check?.checked) return '';
      const url = new URL(document.documentElement.lang === 'en' ? '/en/board/' : '/pano/', location.origin);
      url.searchParams.set('p', board.join(','));
      return url.href;
    };

    const validate = () => {
      let ok = true;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) => {
        const valid = el.type === 'checkbox' ? (el as HTMLInputElement).checked : el.checkValidity();
        el.classList.toggle('invalid', !valid);
        el.setAttribute('aria-invalid', String(!valid));
        if (!valid && ok) {
          el.focus();
          ok = false;
        }
      });
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const fd = new FormData(form);
      fd.set('board', boardText());
      submit.disabled = true;
      status.className = 'status mono';
      status.textContent = M.sending;
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => null);
        if (!res.ok || !data?.ok) throw new Error('send');
        status.classList.add('ok');
        status.textContent = M.ok;
        form.reset();
        try {
          sessionStorage.removeItem('demirce-brief');
        } catch {}
      } catch {
        // Yedek: e-posta istemcisi ile gönder
        status.classList.add('err');
        status.textContent = M.fallback;
        const body = [
          `${fd.get('name')} <${fd.get('email')}>`,
          fd.get('phone') ? `Tel: ${fd.get('phone')}` : '',
          '',
          String(fd.get('message') || ''),
          fd.get('board') ? `\nPano: ${fd.get('board')}` : '',
        ]
          .filter((l) => l !== null)
          .join('\n');
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`[demirce.com] ${fd.get('subject')}`)}&body=${encodeURIComponent(body)}`;
      } finally {
        submit.disabled = false;
      }
    });
    form.addEventListener('input', (e) => (e.target as HTMLElement).classList.remove('invalid'));
  }

  // Alsancak'ta şimdi: yerel saat + güneş
  const now = document.querySelector<HTMLElement>('[data-now]');
  if (now) {
    const lat = Number(now.dataset.lat);
    const lon = Number(now.dataset.lon);
    const off = Number(now.dataset.offset);
    const en = document.documentElement.lang === 'en';
    const tick = () => {
      const d = new Date();
      const local = new Date(d.getTime() + off * 3600000);
      now.querySelector('[data-now-time]')!.textContent = `${String(local.getUTCHours()).padStart(2, '0')}:${String(local.getUTCMinutes()).padStart(2, '0')}`;
      const p = sunPosition(d, lat, lon);
      const alt = (p.altitude * 180) / Math.PI;
      now.querySelector('[data-now-sun]')!.textContent =
        alt > 0
          ? en
            ? `☀ Sun ${alt.toFixed(0)}° high, bearing ${compassBearing(p.azimuth).toFixed(0)}°`
            : `☀ Güneş ${alt.toFixed(0)}° yükseklikte, ${compassBearing(p.azimuth).toFixed(0)}° yönünde`
          : en
            ? '☾ The sun has set over the bay'
            : '☾ Güneş körfezde battı';
    };
    tick();
    setInterval(tick, 30000);
  }
</script>
