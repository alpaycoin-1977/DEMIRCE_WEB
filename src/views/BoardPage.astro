---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { ROUTES, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c =
  lang === 'tr'
    ? {
        title: 'İlham Panosu',
        lead: 'Proje galerilerinde ♥ ile işaretlediğiniz görseller burada toplanır. Panonuzu paylaşın ya da brifinize ekleyerek bize gönderin.',
        privacy: 'Panonuz yalnızca bu tarayıcıda saklanır; sunucumuza gönderilmez.',
        empty: 'Panonuz henüz boş.',
        emptyText: 'Projelere göz atın ve beğendiğiniz görsellerdeki ♥ düğmesine dokunun — ya da başlamak için rastgele bir seçki oluşturun.',
        inspire: 'Bana ilham ver',
        browse: 'Projelere göz at',
        share: 'Panoyu paylaş',
        send: 'Ofise gönder',
        clear: 'Temizle',
        confirmClear: 'Panodaki tüm görseller kaldırılsın mı?',
        shared: 'Size bir ilham panosu paylaşıldı.',
        import: 'Panoma ekle',
        copied: 'Pano bağlantısı kopyalandı',
        remove: 'Kaldır',
        count: 'görsel',
      }
    : {
        title: 'Mood Board',
        lead: 'Images you mark with ♥ in project galleries collect here. Share your board, or attach it to your brief and send it to us.',
        privacy: 'Your board is stored only in this browser; it is never sent to our server.',
        empty: 'Your board is empty.',
        emptyText: 'Browse the projects and tap ♥ on images you like — or start with a random selection.',
        inspire: 'Inspire me',
        browse: 'Browse projects',
        share: 'Share board',
        send: 'Send to the studio',
        clear: 'Clear',
        confirmClear: 'Remove all images from the board?',
        shared: 'Someone shared a mood board with you.',
        import: 'Add to my board',
        copied: 'Board link copied',
        remove: 'Remove',
        count: 'images',
      };
---

<Base lang={lang} title={c.title} description={c.lead} route="board" sheet="A-50" noindex>
  <div class="wrap page-head">
    <p class="label muted"><span class="accent">A-50 — </span><span data-count>0</span> {c.count}</p>
    <h1 class="display">{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <p class="mono muted small">{c.privacy}</p>
  </div>

  <div class="wrap" data-board-page data-lang={lang} data-l={JSON.stringify(c)} data-contact={ROUTES.contact[lang]}>
    <div class="shared crop" data-shared hidden>
      <p>{c.shared}</p>
      <button type="button" class="btn btn--accent" data-import><Icon name="heart" size={16} />{c.import}</button>
    </div>
    <div class="bar" data-bar hidden>
      <button type="button" class="btn btn--accent" data-send>{c.send} <Icon name="arrow-right" /></button>
      <button type="button" class="btn btn--ghost" data-share-board><Icon name="share" size={16} />{c.share}</button>
      <button type="button" class="btn btn--ghost" data-inspire><Icon name="plus" size={16} />{c.inspire}</button>
      <button type="button" class="btn btn--ghost" data-clear><Icon name="trash" size={16} />{c.clear}</button>
    </div>
    <div class="empty crop" data-empty hidden>
      <Icon name="heart" size={40} />
      <h2 class="display">{c.empty}</h2>
      <p>{c.emptyText}</p>
      <div class="empty-actions">
        <button type="button" class="btn btn--accent" data-inspire>{c.inspire}</button>
        <a class="btn btn--ghost" href={ROUTES.projects[lang]}>{c.browse}</a>
      </div>
    </div>
    <ul class="masonry" data-grid></ul>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 120px) clamp(32px, 4vw, 56px);
  }
  .page-head h1 {
    font-size: var(--step-5);
    margin: 18px 0 24px;
  }
  .small {
    font-size: 0.7rem;
  }
  .bar,
  .shared {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
    align-items: center;
  }
  .shared {
    justify-content: space-between;
    padding: 16px 20px;
    border: 1px solid var(--accent);
  }
  .shared p {
    margin: 0;
  }
  .empty {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(32px, 6vw, 80px);
    border: 1px dashed var(--line-strong);
  }
  .empty h2 {
    font-size: var(--step-4);
  }
  .empty p {
    max-width: 52ch;
    color: var(--ink-2);
    margin: 0;
  }
  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 4 260px;
    column-gap: 16px;
  }
  .masonry :global(li) {
    break-inside: avoid;
    margin-bottom: 16px;
    position: relative;
    animation: pop 0.4s var(--ease-out) both;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  .masonry :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .masonry :global(.cap) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 2px solid var(--pc);
  }
  .masonry :global(.cap a) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .masonry :global(.cap a:hover) {
    color: var(--accent-text);
  }
  .masonry :global(.rm) {
    border: 0;
    background: none;
    padding: 6px;
    color: var(--ink-3);
  }
  .masonry :global(.rm:hover) {
    color: var(--accent-text);
  }
</style>

<script>
  import { getBoard, setBoard, BOARD_EVENT } from '~/scripts/board';
  import { toast } from '~/scripts/ui';

  const root = document.querySelector<HTMLElement>('[data-board-page]');
  if (root) {
    const L = JSON.parse(root.dataset.l || '{}');
    const li = root.dataset.lang === 'en' ? 1 : 0;
    const grid = root.querySelector<HTMLUListElement>('[data-grid]')!;
    const params = new URLSearchParams(location.search);
    const sharedIds = (params.get('p') || '').split(',').filter(Boolean);
    let data: Record<string, { s: string; w: number; h: number; t: [string, string]; u: [string, string]; c: string }> = {};
    let viewingShared = sharedIds.length > 0;

    const ids = () => (viewingShared ? sharedIds : getBoard()).filter((id) => data[id]);
    const render = () => {
      const list = ids();
      document.querySelectorAll('[data-count]').forEach((el) => (el.textContent = String(list.length)));
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = list.length > 0;
      root.querySelector<HTMLElement>('[data-bar]')!.hidden = list.length === 0 || viewingShared;
      root.querySelector<HTMLElement>('[data-shared]')!.hidden = !viewingShared;
      grid.innerHTML = '';
      list.forEach((id, n) => {
        const d = data[id];
        const item = document.createElement('li');
        item.style.setProperty('--pc', d.c);
        item.style.animationDelay = `${Math.min(n, 12) * 40}ms`;
        const img = document.createElement('img');
        img.src = d.s;
        img.width = d.w;
        img.height = d.h;
        img.loading = 'lazy';
        img.alt = d.t[li];
        const cap = document.createElement('div');
        cap.className = 'cap';
        const a = document.createElement('a');
        a.href = d.u[li];
        a.textContent = d.t[li];
        cap.append(a);
        if (!viewingShared) {
          const rm = document.createElement('button');
          rm.className = 'rm';
          rm.type = 'button';
          rm.setAttribute('aria-label', `${L.remove}: ${d.t[li]}`);
          rm.textContent = '✕';
          rm.addEventListener('click', () => setBoard(getBoard().filter((x) => x !== id)));
          cap.append(rm);
        }
        item.append(img, cap);
        grid.append(item);
      });
    };

    fetch('/board-data.json')
      .then((r) => r.json())
      .then((d) => {
        data = d;
        render();
      });
    addEventListener(BOARD_EVENT, render);

    root.querySelectorAll('[data-inspire]').forEach((b) =>
      b.addEventListener('click', () => {
        const keys = Object.keys(data);
        const pick = new Set(getBoard());
        let guard = 0;
        while (pick.size < getBoard().length + 6 && guard++ < 200) pick.add(keys[Math.floor(Math.random() * keys.length)]);
        viewingShared = false;
        setBoard([...pick]);
      }),
    );
    root.querySelector('[data-clear]')!.addEventListener('click', () => {
      if (confirm(L.confirmClear)) setBoard([]);
    });
    root.querySelector('[data-share-board]')!.addEventListener('click', async () => {
      const u = new URL(location.href);
      u.search = '';
      u.searchParams.set('p', getBoard().join(','));
      try {
        if (navigator.share) await navigator.share({ title: document.title, url: u.href });
        else {
          await navigator.clipboard.writeText(u.href);
          toast(L.copied);
        }
      } catch {}
    });
    root.querySelector('[data-send]')!.addEventListener('click', () => (location.href = `${root.dataset.contact}?pano=1`));
    root.querySelector('[data-import]')!.addEventListener('click', () => {
      setBoard([...new Set([...sharedIds, ...getBoard()])]);
      viewingShared = false;
      history.replaceState(null, '', location.pathname);
      render();
    });
  }
</script>
