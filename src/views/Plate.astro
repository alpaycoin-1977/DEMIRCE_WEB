---
/** LEVHA — derinlemesine incelenmeyen çalışmalar için sade sayfa */
import { Image } from 'astro:assets';
import Book from '~/layouts/Book.astro';
import Facade from '~/components/Facade.astro';
import { PHI } from '~/lib/geometry';
import Name from '~/components/Name.astro';
import { formatCoords } from '~/lib/text';
import { cases } from '~/data/cases';
import { projects, countryName, type Project } from '~/data/projects';
import { projectImages } from '~/lib/images';
import { u, projectUrl, type Lang } from '~/i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const imgs = projectImages(p.slug);
const cover = imgs[0];
const diag = new Set(p.diagrams ?? []);
const rest = imgs.slice(1).filter((_, k) => !diag.has(k + 1)).slice(0, 9);
const diagrams = imgs.filter((_, k) => diag.has(k));
const plates = projects.filter((x) => !cases.some((c) => c.slug === x.slug));
const next = plates[(plates.indexOf(p) + 1) % plates.length];
const place = [p.district?.[lang], p.city?.[lang]].filter(Boolean).join(', ');
const coords = p.coords ? formatCoords(p.coords[0], p.coords[1], lang) : undefined;
const L =
  lang === 'tr'
    ? { index: 'Dizin', back: 'Dizine dön', next: 'Sonraki', place: 'Yer', year: 'Yıl', client: 'İşveren', award: 'Ödül', status: 'Durum', scope: 'Kapsam' }
    : { index: 'Index', back: 'Back to index', next: 'Next', place: 'Place', year: 'Year', client: 'Client', award: 'Award', status: 'Status', scope: 'Scope' };
const ld = {
  '@type': 'CreativeWork',
  name: p.title[lang],
  description: p.summary[lang],
  genre: 'Architecture',
  creator: { '@id': 'https://www.demirce.com/#ofis' },
  ...(p.year ? { dateCreated: String(p.year) } : {}),
  ...(place ? { locationCreated: { '@type': 'Place', name: place } } : {}),
  inLanguage: lang,
};
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'tr' ? 'Çalışmalar' : 'Works', item: new URL(u(lang === 'tr' ? '/projeler/' : '/en/projects/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: p.title[lang], item: new URL(projectUrl(p.slug, lang), Astro.site).href },
  ],
};
const facts: [string, string][] = [
  [L.place, [place, countryName(p.country, lang)].filter(Boolean).join(' · ')],
  ...(p.year ? ([[L.year, String(p.year)]] as [string, string][]) : []),
  ...(p.client ? ([[L.client, p.client]] as [string, string][]) : []),
  ...(p.award ? ([[L.award, p.award[lang]]] as [string, string][]) : []),
  ...(p.status ? ([[L.status, p.status[lang]]] as [string, string][]) : []),
  [L.scope, p.scope[lang].join(', ')],
];
---

<Book lang={lang} title={p.title[lang]} description={p.summary[lang]} alternates={{ tr: projectUrl(p.slug, 'tr'), en: projectUrl(p.slug, 'en') }} image={cover} jsonLd={[ld, crumbs]}>
  <article class="wrap">
    <header class="p-head">
      <p class="sec-head" aria-hidden="true"><span class="n">{String(plates.indexOf(p) + 1).padStart(2, '0')}</span><b>{L.index}</b><span class="fill"></span><span class="note">{p.year ?? ''}</span></p>
      <a class="label muted back" href={u(lang === 'tr' ? '/projeler/' : '/en/projects/') + '#dizin'}>← {L.back}</a>
      <div class="p-grid">
        <div>
          <h1><Name text={p.title[lang]} lang={lang} /></h1>
          <p class="mono muted pmeta">{[place, countryName(p.country, lang), p.year].filter(Boolean).join(' · ')}</p>
        </div>
        {
          coords && (
            <p class="sign">
              <b>
                <Name text={p.title[lang]} lang={lang} />
              </b>
              <span>{coords}</span>
            </p>
          )
        }
      </div>
    </header>
    <Facade seed={p.slug} class="p-land" ratio={PHI ** 4} levels={6} dense={0.45} />
    <figure class="cover">
      <Image src={cover} alt={p.title[lang]} widths={[800, 1200, 1600, 2000].filter((w) => w <= cover.width)} sizes="(min-width: 1520px) 1400px, 100vw" loading="eager" />
    </figure>
    <div class="body">
      <dl class="facts">
        {
          facts.map(([k, v]) => (
            <div>
              <dt class="mono muted">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="prose">
        {p.body[lang].map((para) => (para.startsWith('## ') ? <h2>{para.slice(3)}</h2> : <p>{para}</p>))}
      </div>
    </div>
    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((img) => (
            <Image src={img} alt={p.title[lang]} widths={[480, 800, 1200].filter((w) => w <= img.width)} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" class="rise" />
          ))}
        </div>
      )
    }
    {
      diagrams.length > 0 && (
        <div class="grid diagrams">
          {diagrams.map((img) => (
            <Image src={img} alt="" widths={[480, 800].filter((w) => w <= img.width).concat(img.width < 480 ? [img.width] : [])} sizes="(min-width: 900px) 25vw, 50vw" loading="lazy" />
          ))}
        </div>
      )
    }
    <nav class="p-next">
      <a href={projectUrl(next.slug, lang)}>
        <span class="label muted">{L.next}</span>
        <span class="nt"><Name text={next.title[lang]} lang={lang} /></span>
      </a>
    </nav>
  </article>
</Book>

<style>
  .p-head {
    padding-block: clamp(28px, 3.4vw, 48px) clamp(20px, 2.4vw, 32px);
  }
  .p-head .sec-head {
    margin-bottom: 20px;
  }
  .back {
    text-decoration: none;
  }
  .p-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: clamp(28px, 4vw, 56px);
  }
  h1 {
    font-size: var(--t-mega);
    line-height: 0.84;
    margin: 0 0 16px;
  }
  .pmeta {
    text-transform: uppercase;
    margin: 0;
  }
  .sign {
    margin: 0;
  }
  article :global(.p-land) {
    margin-bottom: clamp(8px, 1.2vw, 16px);
  }
  .cover :global(img) {
    width: 100%;
    max-height: 84vh;
    object-fit: cover;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(0, 2fr);
    gap: clamp(24px, 6vw, 96px);
    padding-block: clamp(40px, 6vw, 88px);
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .facts div {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 12px;
    font-size: var(--t-s);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    text-transform: uppercase;
    padding-top: 2px;
  }
  .facts dd {
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 1.2vw, 16px);
  }
  .grid :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .diagrams {
    margin-top: clamp(8px, 1.2vw, 16px);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .diagrams :global(img) {
    object-fit: contain;
    background: #fff;
  }
  .p-next {
    margin-top: clamp(64px, 9vw, 120px);
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .p-next a {
    display: grid;
    gap: 6px;
    text-decoration: none;
  }
  .nt {
    font-family: var(--display);
    font-stretch: 68%;
    font-weight: 560;
    font-size: var(--t-xxl);
    line-height: 0.9;
    text-transform: uppercase;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
