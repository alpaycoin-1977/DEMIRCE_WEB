---
import { getCollection } from 'astro:content';
import Book from '~/layouts/Book.astro';
import PageHead from '~/components/PageHead.astro';
import { postUrl, formatDate, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const posts = (await getCollection('journal', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const c = lang === 'tr' ? { title: 'Notlar', lead: 'Ödüller, yarışmalar, şantiyeler, sergiler ve mimarlık üzerine.' } : { title: 'Notes', lead: 'Awards, competitions, sites, exhibitions and thoughts on architecture.' };
---

<Book lang={lang} title={c.title} description={c.lead} alternates={{ tr: '/gunluk/', en: '/en/journal/' }}>
  <PageHead n="03" label={c.title} note={`${years.at(-1)} — ${years[0]}`} title={c.title} lead={c.lead} seed="notlar" hair={0.3} />
  <div class="wrap">
    {
      years.map((y) => (
        <section class="year">
          <h2 class="yr">{y}</h2>
          <ul>
            {posts
              .filter((p) => p.data.date.getFullYear() === y)
              .map((p) => (
                <li>
                  <a href={postUrl(p.id.split('/')[1], lang)}>
                    <span class="t">{p.data.title}</span>
                    <span class="d">{p.data.description}</span>
                    <time class="mono muted" datetime={p.data.date.toISOString()}>
                      {formatDate(p.data.date, lang)}
                    </time>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</Book>

<style>
  .yr {
    font-size: var(--t-xl);
    line-height: 0.9;
    color: var(--muted);
  }
  .year {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(0, 4fr);
    gap: 24px;
    border-top: 1px solid var(--ink);
    padding-top: 14px;
    margin-bottom: 40px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: grid;
    gap: 4px;
    padding-bottom: 22px;
    text-decoration: none;
  }
  .t {
    font-family: var(--serif);
    font-size: var(--t-l);
    line-height: 1.2;
  }
  li a:hover .t {
    text-decoration: underline;
    text-decoration-color: var(--rule-2);
  }
  .d {
    color: var(--ink-2);
    max-width: 40em;
  }
  @media (max-width: 700px) {
    .year {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
