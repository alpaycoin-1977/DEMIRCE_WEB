---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import SectionHead from '~/components/SectionHead.astro';
import Icon from '~/components/Icon.astro';
import { services, process } from '~/data/services';
import { getProject, CATEGORY_ORDER, projects } from '~/data/projects';
import { projectCover } from '~/lib/images';
import { ROUTES, t, projectUrl, type Lang } from '~/i18n/ui';
import { brandSafe } from '~/lib/text';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const c =
  lang === 'tr'
    ? {
        title: 'Hizmetler',
        lead: 'Arsanın ilk okumasından şantiyedeki son detaya kadar: mimari, iç mimari ve peyzajı tek bir konsept altında tasarlıyoruz.',
        processLabel: 'Süreç',
        processTitle: 'Nasıl çalışıyoruz',
        typLabel: 'Tipolojiler',
        typTitle: 'Uzmanlık alanları',
        faqLabel: 'Sık sorulanlar',
        faqTitle: 'Sorular',
        related: 'İlgili projeler',
        faq: [
          ['Bir projeye nasıl başlıyoruz?', 'İlk görüşmede hedeflerinizi, arsanın imar durumunu ve programı birlikte konuşuruz. İsterseniz önce sitemizdeki Arsa Potansiyeli Hesaplayıcı ile ön bir fikir edinip sonucu bize gönderebilirsiniz.'],
          ['Hangi şehirlerde çalışıyorsunuz?', 'Ofisimiz İzmir Alsancak’ta. İzmir, İstanbul, Antalya, Denizli, Mersin, Aydın ve Kazakistan’ın Atırav kentinde projelerimiz bulunuyor; yurt içi ve yurt dışı projeleri değerlendiriyoruz.'],
          ['Yalnızca iç mimarlık hizmeti alabilir miyim?', 'Evet. Otel, rezidans, konut ve ofis iç mekânlarını bağımsız olarak da tasarlıyoruz; mümkün olduğunda mimariyle birlikte tek bir konsept altında ele almayı öneriyoruz.'],
          ['Mimari proje yarışmalarına katılıyor musunuz?', 'Evet. Ulusal yarışmalarda birincilik ve eşdeğer ikincilik ödülleri aldık; yarışmaları araştırma ve gelişim alanı olarak görüyoruz.'],
          ['Fizibilite aracındaki sonuçlar ne kadar kesin?', 'Hesaplayıcı yalnızca ön fikir verir. Kesin sonuçlar imar durumu belgesi, plan notları, yönetmelikler ve arsanın gerçek verileriyle yapılacak bir çalışmayla belirlenir.'],
        ],
        ctaTitle: 'Arsanızın potansiyelini 1 dakikada görün',
        ctaText: 'Arsa alanı, emsal ve TAKS ile inşaat alanını, kat adedini ve oda / daire kapasitesini hesaplayın.',
      }
    : {
        title: 'Services',
        lead: 'From the first reading of a site to the last detail on site: we design architecture, interiors and landscape under one concept.',
        processLabel: 'Process',
        processTitle: 'How we work',
        typLabel: 'Typologies',
        typTitle: 'Areas of expertise',
        faqLabel: 'FAQ',
        faqTitle: 'Questions',
        related: 'Related projects',
        faq: [
          ['How does a project start?', 'In a first meeting we discuss your goals, the zoning status of the site and the brief. You can also get a first idea with the Site Potential Calculator on this website and send us the result.'],
          ['Where do you work?', 'Our studio is in Alsancak, İzmir. We have projects in İzmir, Istanbul, Antalya, Denizli, Mersin, Aydın and Atyrau, Kazakhstan, and we consider projects in Turkey and abroad.'],
          ['Can I commission interior design only?', 'Yes. We design hotel, residential and office interiors independently; where possible we recommend treating them together with the architecture under one concept.'],
          ['Do you take part in competitions?', 'Yes. We have won a first prize and a joint second prize in national competitions, and see competitions as a field for research and growth.'],
          ['How accurate is the feasibility tool?', 'The calculator gives a first indication only. Definitive figures depend on the zoning certificate, plan notes, regulations and real site data.'],
        ],
        ctaTitle: 'See your site’s potential in a minute',
        ctaText: 'Calculate buildable area, storeys and room / unit capacity from site area, FAR and site coverage.',
      };
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: c.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const cats = CATEGORY_ORDER.map((k) => ({ k, n: projects.filter((p) => p.categories.includes(k)).length }));
---

<Base lang={lang} title={c.title} description={c.lead} route="services" sheet="A-30" jsonLd={[faqLd]}>
  <div class="wrap page-head">
    <p class="label muted"><span class="accent">A-30 — </span>{tr('nav.services')}</p>
    <h1 class="display">{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <nav class="toc" aria-label={c.title}>
      {services.map((s, i) => <a class="chip" href={`#${s.id}`}>{String(i + 1).padStart(2, '0')} {s.title[lang]}</a>)}
    </nav>
  </div>

  <div class="wrap">
    {
      services.map((s, i) => (
        <section class="svc" id={s.id} aria-labelledby={`${s.id}-t`}>
          <span class="display svc-n">{String(i + 1).padStart(2, '0')}</span>
          <div class="svc-main">
            <h2 id={`${s.id}-t`} class="display">{s.title[lang]}</h2>
            <p class="svc-body">{s.body[lang]}</p>
            <ul class="svc-points">
              {s.points[lang].map((pt) => (
                <li>
                  <Icon name="check" size={16} /> {pt}
                </li>
              ))}
            </ul>
          </div>
          <div class="svc-rel">
            <p class="label muted">{c.related}</p>
            <ul>
              {s.projects.map((slug) => {
                const p = getProject(slug)!;
                return (
                  <li>
                    <a href={projectUrl(slug, lang)} style={`--pc:${p.color}`}>
                      <Image src={projectCover(slug)} alt="" width={240} widths={[160, 320]} sizes="160px" loading="lazy" />
                      <span set:html={brandSafe(p.title[lang], lang)} />
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <section class="wrap section" aria-labelledby="surec">
    <SectionHead index="07" label={c.processLabel} title={c.processTitle} id="surec" />
    <ol class="process">
      {
        process.map((st, i) => (
          <li class="reveal">
            <span class="mono accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display">{st.title[lang]}</h3>
            <p>{st.text[lang]}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="tipoloji">
    <SectionHead index="08" label={c.typLabel} title={c.typTitle} id="tipoloji" />
    <ul class="typ">
      {
        cats
          .filter((x) => x.n > 0)
          .map((x) => (
            <li>
              <a href={`${ROUTES.projects[lang]}?kategori=${x.k}`}>
                <span class="display">{tr(`cat.${x.k}` as const)}</span>
                <span class="mono muted">{x.n}</span>
              </a>
            </li>
          ))
      }
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="sss">
    <SectionHead index="09" label={c.faqLabel} title={c.faqTitle} id="sss" />
    <div class="faq">
      {
        c.faq.map(([q, a]) => (
          <details>
            <summary>
              <span>{q}</span>
              <Icon name="plus" />
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <a class="cta crop" href={ROUTES.feasibility[lang]}>
      <span class="display">{c.ctaTitle}</span>
      <span class="cta-text">{c.ctaText}</span>
      <span class="btn btn--accent">{tr('nav.feasibility')} <Icon name="arrow-right" /></span>
    </a>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 120px) clamp(32px, 4vw, 56px);
  }
  .page-head h1 {
    font-size: var(--step-5);
    margin: 18px 0 24px;
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }
  .svc {
    display: grid;
    grid-template-columns: 120px minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 64px);
    padding-block: clamp(40px, 6vw, 88px);
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .svc-n {
    font-size: var(--step-4);
    color: var(--accent-text);
  }
  .svc h2 {
    font-size: var(--step-4);
    margin-bottom: 20px;
  }
  .svc-body {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .svc-points {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
  }
  .svc-points li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .svc-points :global(svg) {
    color: var(--accent-text);
    flex: none;
    transform: translateY(3px);
  }
  .svc-rel ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .svc-rel a {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    font-family: var(--font-display);
    font-stretch: 75%;
    font-size: var(--step-1);
    text-transform: uppercase;
    border-left: 3px solid var(--pc);
    padding-left: 10px;
  }
  .svc-rel a:hover {
    color: var(--accent-text);
  }
  .svc-rel :global(img) {
    width: 96px;
    height: 64px;
    object-fit: cover;
  }
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    counter-reset: s;
  }
  .process li {
    padding: 20px 20px 20px 0;
    border-top: 1px solid var(--ink);
    position: relative;
  }
  .process li::after {
    content: '→';
    position: absolute;
    right: 8px;
    top: 16px;
    color: var(--ink-3);
  }
  .process li:last-child::after {
    content: none;
  }
  .process h3 {
    font-size: var(--step-3);
    margin: 10px 0;
  }
  .process p {
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .typ {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    border-top: 1px solid var(--line);
  }
  .typ a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 20px 16px 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .typ .display {
    font-size: var(--step-3);
  }
  .typ a:hover .display {
    color: var(--accent-text);
  }
  .faq {
    border-top: 1px solid var(--line);
    max-width: 960px;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--step-1);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    flex: none;
    transition: transform 0.3s var(--ease);
  }
  details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  details p {
    padding-bottom: 20px;
    color: var(--ink-2);
    max-width: 70ch;
  }
  .cta {
    display: grid;
    grid-template-columns: 1.4fr 1fr auto;
    align-items: center;
    gap: 24px;
    padding: clamp(24px, 4vw, 56px);
    border: 1px solid var(--line-strong);
    text-decoration: none;
    transition: background 0.3s;
  }
  .cta:hover {
    background: var(--paper-2);
  }
  .cta .display {
    font-size: var(--step-3);
  }
  .cta-text {
    color: var(--ink-2);
  }
  @media (max-width: 1000px) {
    .svc {
      grid-template-columns: 1fr;
    }
    .process {
      grid-template-columns: 1fr 1fr;
    }
    .cta {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
  @media (max-width: 600px) {
    .svc-points,
    .process {
      grid-template-columns: 1fr;
    }
  }
</style>
