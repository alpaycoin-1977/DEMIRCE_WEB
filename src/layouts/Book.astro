---
import '~/styles/book.css';
import displayWoff from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Logo from '~/components/Logo.astro';
import Figure from '~/components/Figure.astro';
import { SITE } from '~/data/site';
import { approach } from '~/data/approach';
import { projectCover } from '~/lib/images';
import { formatCoords, brandSafe } from '~/lib/text';
import { u, logical, postUrl, formatDate, PREVIEW, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  alternates: { tr: string; en: string };
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** Başlıkta ortada görünen "akan başlık" (kitaplardaki gibi) */
  running?: string;
  noindex?: boolean;
}
const { lang, title, description, alternates, image, type = 'website', jsonLd = [], running, noindex } = Astro.props;
const T = {
  tr: {
    works: 'Çalışmalar',
    office: 'Ofis',
    notes: 'Notlar',
    contact: 'İletişim',
    tagline: 'Mimarlık · İç mimarlık · Peyzaj — İzmir, 1999’dan beri',
    short: 'Mimarlık · İç mimarlık · Peyzaj',
    desc: "DEMİRCE, 1999'dan bu yana İzmir'de çalışan bir mimarlık ofisi. Bir otel odasının detayından bir kentsel dönüşüm adasına kadar mimari, iç mekân ve peyzaj.",
    skip: 'İçeriğe geç',
    menu: 'Menü',
    close: 'Kapat',
    privacy: 'KVKK',
    approach: 'Yaklaşım',
    allNotes: 'Tüm notlar',
    contactLine: 'Bir sonraki soruyu birlikte soralım.',
    directions: 'Yol tarifi',
    top: 'Başa dön',
  },
  en: {
    works: 'Works',
    office: 'Studio',
    notes: 'Notes',
    contact: 'Contact',
    tagline: 'Architecture · Interiors · Landscape — İzmir, since 1999',
    short: 'Architecture · Interiors · Landscape',
    desc: 'DEMİRCE is an architecture studio working from İzmir since 1999 — from the detail of a hotel room to an urban regeneration block: architecture, interiors and landscape.',
    skip: 'Skip to content',
    menu: 'Menu',
    close: 'Close',
    privacy: 'Privacy',
    approach: 'Approach',
    allNotes: 'All notes',
    contactLine: 'Let’s ask the next question together.',
    directions: 'Directions',
    top: 'Back to top',
  },
}[lang];
const home = u(lang === 'tr' ? '/' : '/en/');
const nav = [
  { href: u(lang === 'tr' ? '/projeler/' : '/en/projects/'), label: T.works },
  { href: u(lang === 'tr' ? '/ofis/' : '/en/studio/'), label: T.office },
  { href: u(lang === 'tr' ? '/gunluk/' : '/en/journal/'), label: T.notes },
  { href: u(lang === 'tr' ? '/iletisim/' : '/en/contact/'), label: T.contact },
];
const path = Astro.url.pathname;
const other = lang === 'tr' ? 'en' : 'tr';
const fullTitle = title ? `${title} — DEMİRCE` : `DEMİRCE Mimarlık — ${T.tagline}`;
const desc = description ?? T.desc;
// canonical ve hreflang her zaman gerçek site adresini gösterir
const canonical = new URL(logical(path), SITE.url).href;
const alt = { tr: logical(alternates.tr), en: logical(alternates.en) };
const og = await getImage({ src: image ?? projectCover('mezitli-egitim-kampusu'), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const org = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#ofis`,
  additionalType: 'https://en.wikipedia.org/wiki/Architectural_firm',
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  telephone: SITE.phone,
  foundingDate: String(SITE.founded),
  address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, addressLocality: SITE.address.city, addressCountry: SITE.address.country },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lon },
  sameAs: Object.values(SITE.social),
};
const year = new Date().getFullYear();
const latest = (await getCollection('journal', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const coords = formatCoords(SITE.geo.lat, SITE.geo.lon, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {(noindex || PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" hreflang="tr" href={new URL(alt.tr, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alt.en, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.tr, SITE.url).href} />
    <link rel="alternate" type="application/rss+xml" title="DEMİRCE" href={u(lang === 'tr' ? '/rss.xml' : '/en/rss.xml')} />
    <link rel="preload" href={displayWoff} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="manifest" href={u('/manifest.webmanifest')} />
    <noscript><style>@media (max-width: 900px) { .head-bar { height: auto !important; flex-wrap: wrap; padding-block: 14px; } .nav-btn { display: none !important; } .nav { width: 100%; margin: 0 !important; } .nav-panel { display: block !important; position: static !important; padding: 8px 0 0 !important; background: none !important; } .nav-panel ul { flex-direction: row !important; flex-wrap: wrap; gap: 4px 18px !important; } .nav-panel a { font: 600 0.6875rem/1.4 var(--sans) !important; letter-spacing: 0.12em !important; padding: 4px 0 !important; } .nav-panel .n, .nav-sign { display: none !important; } }</style></noscript>
    <meta name="theme-color" content="#e9e8e4" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site).href} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...ld })} />)}
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }] }, "eagerness": "moderate" }] }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#icerik">{T.skip}</a>
    <header class="site-head">
      <div class="wrap head-bar">
        <a href={home} class="brand" aria-label={SITE.name}><Logo variant="wordmark" /></a>
        <span class="tag label muted">{T.short}</span>
        {running && <span class="running mono muted" aria-hidden="true" set:html={brandSafe(running, lang)} />}
        <nav class="nav" aria-label={T.menu}>
          <button type="button" class="nav-btn" aria-expanded="false" aria-controls="nav-panel">
            <span class="sr-only">{T.menu}</span>
            <span class="grid9" aria-hidden="true">{Array.from({ length: 9 }, () => <i />)}</span>
          </button>
          <div class="nav-panel" id="nav-panel">
            <ul>
              {
                nav.map((n, k) => (
                  <li>
                    <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                      <span class="n mono">{String(k + 1).padStart(2, '0')}</span>
                      <span class="t">{n.label}</span>
                    </a>
                  </li>
                ))
              }
              <li class="lang-li">
                <a href={u(alt[other])} hreflang={other} lang={other} class="lang">{other.toUpperCase()}</a>
              </li>
            </ul>
            <p class="nav-sign sign" aria-hidden="true"><b>DEMİRCE · ALSANCAK</b><span>{coords}</span></p>
          </div>
        </nav>
      </div>
    </header>

    <main id="icerik" tabindex="-1"><slot /></main>

    <!-- Zemin: cephe toprağa basar; ağaçlar ve insanlar ölçek verir -->
    <div class="ground" aria-hidden="true">
      <div class="wrap gr">
        <img src={u('/art/cam-1.svg')} alt="" class="tree t1" loading="lazy" width="600" height="1000" />
        <img src={u('/art/cam-2.svg')} alt="" class="tree t2" loading="lazy" width="600" height="1000" />
        <img src={u('/art/cam-3.svg')} alt="" class="tree t3" loading="lazy" width="600" height="1000" />
        <Figure pose="walk" class="gf g1" />
        <Figure pose="stand" class="gf g2" mirror />
        <Figure pose="look" class="gf g3" />
        <span class="gl mono">{lang === 'tr' ? 'Zemin' : 'Ground'} ±0,00</span>
      </div>
    </div>

    <footer class="site-foot night">
      <div class="wrap foot-top">
        <section class="f-col f-approach" aria-labelledby="f-approach">
          <h2 id="f-approach" class="label f-h"><span class="mono">A</span>{T.approach}</h2>
          {
            approach.map((a, k) => (
              <details name="yaklasim" open={k === 0}>
                <summary>
                  <span class="mono">{String(k + 1).padStart(2, '0')}</span>
                  <span class="at">{a.title[lang]}</span>
                  <span class="pm" aria-hidden="true" />
                </summary>
                <p>{a.body[lang]}</p>
              </details>
            ))
          }
        </section>
        <section class="f-col f-notes" aria-labelledby="f-notes">
          <h2 id="f-notes" class="label f-h"><span class="mono">B</span>{T.notes}</h2>
          <ul>
            {
              latest.map((n) => (
                <li>
                  <a href={postUrl(n.id.split('/')[1], lang)}>
                    <time class="mono" datetime={n.data.date.toISOString()}>{formatDate(n.data.date, lang)}</time>
                    <span>{n.data.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="arrow-link" href={u(lang === 'tr' ? '/gunluk/' : '/en/journal/')}>{T.allNotes}</a>
        </section>
        <section class="f-col f-contact" aria-labelledby="f-contact">
          <h2 id="f-contact" class="label f-h"><span class="mono">C</span>{T.contact}</h2>
          <p class="q f-line">{T.contactLine}</p>
          <p class="f-mail"><a href={`mailto:${SITE.email}`} lang="en">{SITE.email}</a></p>
          <address>
            <a href={SITE.phoneHref}>{SITE.phone}</a><br />
            {SITE.address.street}<br />
            {SITE.address.district} / {SITE.address.city} · <a href={SITE.mapsUrl} target="_blank" rel="noopener">{T.directions}</a>
          </address>
          <p class="social label">
            <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">IG</a>
            <a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">LN</a>
            <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">FB</a>
          </p>
        </section>
      </div>
      <div class="wrap foot-bar mono">
        <span>© {SITE.founded}–{year} DEMİRCE MİMARLIK</span>
        <a href={u(lang === 'tr' ? '/kvkk/' : '/en/privacy/')}>{T.privacy}</a>
        <span class="fb-coords">{coords}</span>
        <a href="#icerik" class="fb-top">{T.top} ↑</a>
      </div>
    </footer>

    <style>
      .site-head {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid var(--rule);
      }
      /* Bulanık zemin ayrı katmanda: başlığın kendisi menü paneli için
         "containing block" olmasın (position: fixed tam ekran kalsın) */
      .site-head::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: color-mix(in srgb, var(--paper) 90%, transparent);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
      }
      .head-bar {
        height: var(--header-h);
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .brand {
        color: var(--ink);
        flex: none;
        display: block;
      }
      .brand :global(.logo) {
        height: 17px;
        width: auto;
        display: block;
      }
      .tag {
        padding-left: 20px;
        border-left: 1px solid var(--rule-2);
        white-space: nowrap;
        line-height: 1;
      }
      .running {
        margin-inline: auto;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
        text-transform: uppercase;
      }
      .nav {
        margin-left: auto;
      }
      .running + .nav {
        margin-left: 0;
      }
      .nav ul {
        display: flex;
        align-items: center;
        gap: clamp(14px, 2.2vw, 34px);
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .nav a {
        display: flex;
        align-items: baseline;
        gap: 6px;
        text-decoration: none;
        font-size: var(--t-xs);
        font-weight: 560;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding-block: 8px;
        color: var(--ink);
      }
      .nav .n {
        font-size: 0.625rem;
        color: var(--muted);
        letter-spacing: 0;
      }
      .nav a:hover .t,
      .nav a[aria-current='page'] .t {
        text-decoration: underline;
        text-underline-offset: 0.35em;
      }
      .lang {
        color: var(--muted) !important;
        font-family: var(--mono);
        letter-spacing: 0.04em !important;
      }
      .nav-sign {
        display: none;
      }
      .nav-btn {
        display: none;
        border: 0;
        background: none;
        padding: 10px;
        margin-right: -10px;
        color: var(--ink);
        cursor: pointer;
      }
      .grid9 {
        display: grid;
        grid-template-columns: repeat(3, 4px);
        gap: 4px;
        transition: transform 0.5s var(--ease);
      }
      .grid9 i {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: currentColor;
        transition: opacity 0.3s;
      }
      .nav.is-open .grid9 {
        transform: rotate(45deg);
      }
      .nav.is-open .grid9 i:nth-child(odd) {
        opacity: 0;
      }
      @media (max-width: 1100px) {
        .tag {
          display: none;
        }
      }
      @media (max-width: 900px) {
        .running {
          display: none;
        }
        .nav,
        .running + .nav {
          margin-left: auto;
        }
        .nav-btn {
          display: block;
          position: relative;
          z-index: 2;
        }
        .nav-panel {
          display: none;
          position: fixed;
          inset: var(--header-h) 0 0 0;
          padding: 28px var(--gutter) 32px;
          background: var(--paper);
          overflow-y: auto;
          flex-direction: column;
          justify-content: space-between;
        }
        .nav.is-open .nav-panel {
          display: flex;
        }
        .nav-panel ul {
          flex-direction: column;
          align-items: stretch;
          gap: 0;
        }
        .nav-panel li {
          border-bottom: 1px solid var(--rule);
        }
        .nav-panel a {
          align-items: center;
          gap: 16px;
          padding-block: 14px;
          font-family: var(--display);
          font-stretch: 68%;
          font-size: clamp(2.6rem, 12vw, 4.4rem);
          line-height: 0.95;
          letter-spacing: 0;
        }
        .nav-panel .n {
          font-size: var(--t-xs);
          width: 2.2em;
        }
        .lang-li {
          border: 0 !important;
        }
        .nav-panel .lang {
          font-size: var(--t-s) !important;
          font-family: var(--mono);
        }
        .nav-sign {
          display: inline-grid;
          align-self: flex-start;
          margin: 32px 0 0;
        }
      }
      :global(html.nav-open) {
        overflow: hidden;
      }

      .ground {
        margin-top: clamp(64px, 8vw, 120px);
        overflow: hidden;
      }
      .gr {
        position: relative;
        height: clamp(220px, 30vw, 460px);
      }
      .tree {
        position: absolute;
        bottom: 0;
        width: auto;
        filter: none;
        pointer-events: none;
      }
      .t1 {
        right: calc(var(--gutter) + 9%);
        height: 100%;
      }
      .t2 {
        right: calc(var(--gutter) + 20%);
        height: 76%;
      }
      .t3 {
        right: calc(var(--gutter) - 1%);
        height: 62%;
      }
      .ground :global(.gf) {
        position: absolute;
        bottom: 0;
        height: clamp(30px, 3.6vw, 52px);
        color: var(--ink);
      }
      .ground :global(.g1) {
        left: 23.6%;
      }
      .ground :global(.g2) {
        left: 61.8%;
      }
      .ground :global(.g3) {
        left: calc(61.8% + 2.2vw);
      }
      .gl {
        position: absolute;
        left: var(--gutter);
        bottom: 10px;
        color: var(--muted);
        text-transform: uppercase;
      }
      .gl::before {
        content: '';
        display: inline-block;
        margin-right: 8px;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 8px solid currentColor;
      }
      @media (max-width: 640px) {
        .t2 {
          right: 34%;
        }
        .t1 {
          right: 8%;
        }
      }
      .site-foot {
        margin-top: 0;
        padding-top: clamp(56px, 7vw, 96px);
      }
      .foot-top {
        display: grid;
        grid-template-columns: 1.15fr 1fr 1.15fr;
        gap: clamp(32px, 5vw, 88px);
        padding-bottom: clamp(48px, 6vw, 80px);
      }
      .f-h {
        display: flex;
        gap: 14px;
        align-items: baseline;
        padding-bottom: 12px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--rule);
        font-family: var(--sans);
        font-stretch: normal;
        font-size: var(--t-xs);
        line-height: 1.4;
      }
      .f-h .mono {
        color: var(--muted);
      }
      details {
        border-bottom: 1px solid var(--rule);
      }
      summary {
        display: grid;
        grid-template-columns: 40px 1fr 14px;
        align-items: center;
        gap: 8px;
        padding-block: 13px;
        cursor: pointer;
        list-style: none;
      }
      summary::-webkit-details-marker {
        display: none;
      }
      summary .mono {
        color: var(--muted);
      }
      .at {
        font-family: var(--display);
        font-stretch: 68%;
        font-weight: 540;
        font-size: 1.35rem;
        text-transform: uppercase;
        line-height: 1;
      }
      .pm {
        position: relative;
        width: 11px;
        height: 11px;
      }
      .pm::before,
      .pm::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: 5px;
        height: 1px;
        background: currentColor;
        transition: transform 0.35s var(--ease);
      }
      .pm::after {
        transform: rotate(90deg);
      }
      details[open] .pm::after {
        transform: rotate(0deg);
      }
      details p {
        margin: -2px 0 18px 48px;
        font-size: var(--t-s);
        color: var(--ink-2);
        max-width: 30em;
      }
      .f-notes ul {
        list-style: none;
        margin: 0 0 28px;
        padding: 0;
      }
      .f-notes li {
        border-bottom: 1px solid var(--rule);
      }
      .f-notes a:not(.arrow-link) {
        display: grid;
        gap: 4px;
        padding-block: 14px;
        text-decoration: none;
        font-size: var(--t-s);
        line-height: 1.4;
      }
      .f-notes a:not(.arrow-link):hover span {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      .f-notes time {
        color: var(--muted);
      }
      .f-line {
        font-size: var(--t-xl);
        line-height: 1.05;
        margin: 22px 0 22px;
      }
      .f-mail {
        margin: 0 0 18px;
      }
      .f-mail a {
        font-family: var(--display);
        font-stretch: 68%;
        font-weight: 520;
        font-size: var(--t-l);
        text-transform: uppercase;
        letter-spacing: 0.01em;
        text-decoration: none;
        border-bottom: 1px solid currentColor;
      }
      address {
        font-style: normal;
        font-size: var(--t-s);
        color: var(--ink-2);
        line-height: 1.6;
      }
      .site-foot a {
        text-decoration-color: var(--rule-2);
      }
      .social {
        display: flex;
        gap: 10px;
        margin: 22px 0 0;
      }
      .social a {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border: 1px solid var(--rule-2);
        border-radius: 50%;
        text-decoration: none;
        letter-spacing: 0.06em;
        transition: background 0.3s, color 0.3s;
      }
      .social a:hover {
        background: var(--ink);
        color: var(--paper);
      }
      .site-foot :global(.foot-land) {
        height: clamp(150px, 18vw, 260px);
        border-block: 1px solid var(--rule);
      }
      .foot-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 28px;
        align-items: center;
        padding-block: 20px 28px;
        color: var(--muted);
        text-transform: uppercase;
      }
      .foot-bar a {
        text-decoration: none;
      }
      .foot-bar a:hover {
        color: var(--ink);
      }
      .fb-coords {
        margin-left: auto;
      }
      @media (max-width: 960px) {
        .foot-top {
          grid-template-columns: 1fr 1fr;
        }
        .f-contact {
          grid-column: 1 / -1;
          grid-row: 1;
        }
      }
      @media (max-width: 640px) {
        .foot-top {
          grid-template-columns: 1fr;
        }
        .fb-coords {
          margin-left: 0;
        }
      }
    </style>
    <script>
      const nav = document.querySelector<HTMLElement>('.nav');
      const btn = nav?.querySelector<HTMLButtonElement>('.nav-btn');
      const setOpen = (open: boolean) => {
        nav!.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('nav-open', open);
        btn!.setAttribute('aria-expanded', String(open));
      };
      btn?.addEventListener('click', () => setOpen(!nav!.classList.contains('is-open')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
          setOpen(false);
          btn?.focus();
        }
      });
      matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && setOpen(false));
    </script>
  </body>
</html>
