---
import '~/styles/global.css';
import sairaWoff from '@fontsource-variable/saira/files/saira-latin-wdth-normal.woff2?url';
import sairaExtWoff from '@fontsource-variable/saira/files/saira-latin-ext-wdth-normal.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import CommandPalette from '~/components/CommandPalette.astro';
import { SITE } from '~/data/site';
import { projects, placeLabel } from '~/data/projects';
import { projectCover } from '~/lib/images';
import { ROUTES, t, projectUrl, postUrl, type Lang, type RouteKey } from '~/i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Dil alternatifi için sayfa anahtarı veya açık yollar */
  route?: RouteKey;
  alternates?: { tr: string; en: string };
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** Pafta kodu — altbilgideki antet için */
  sheet?: string;
  noindex?: boolean;
  /** Sayfaya özel vurgu rengi */
  accent?: string;
  published?: Date;
}

const {
  lang,
  title,
  description,
  route,
  alternates: alt,
  image,
  imageAlt,
  type = 'website',
  jsonLd = [],
  sheet = 'A-00',
  noindex = false,
  accent,
  published,
} = Astro.props;
const tr = t(lang);
const alternates = alt ?? (route ? { tr: ROUTES[route].tr, en: ROUTES[route].en } : { tr: ROUTES.home.tr, en: ROUTES.home.en });
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${tr('meta.tagline')}`;
const desc = description ?? tr('meta.description');
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogSource = image ?? projectCover('fenix84-antalya');
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogUrl = new URL(og.src, SITE.url).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#ofis`,
  additionalType: 'https://en.wikipedia.org/wiki/Architectural_firm',
  name: SITE.name,
  alternateName: SITE.alternateName,
  url: SITE.url,
  logo: `${SITE.url}/icons/icon-512.png`,
  image: ogUrl,
  email: SITE.email,
  telephone: SITE.phone,
  foundingDate: String(SITE.founded),
  description: desc,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.district,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lon },
  areaServed: ['TR', 'KZ'],
  knowsAbout: ['Architecture', 'Interior design', 'Landscape architecture', 'Hotel design', 'Mixed-use development', 'Urban regeneration'],
  sameAs: Object.values(SITE.social),
};

// Komut paleti için arama verisi
const posts = (await getCollection('journal', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const searchData = {
  projects: projects.map((p) => ({
    t: p.title[lang],
    s: [placeLabel(p, lang), ...p.categories.map((c) => tr(`cat.${c}` as const))].join(' · '),
    u: projectUrl(p.slug, lang),
    c: p.color,
  })),
  posts: posts.map((p) => ({ t: p.data.title, s: p.data.date.getFullYear().toString(), u: postUrl(p.id.split('/')[1], lang) })),
  pages: (['home', 'projects', 'office', 'services', 'feasibility', 'board', 'journal', 'contact', 'privacy'] as RouteKey[]).map((k) => ({
    t: k === 'home' ? tr('nav.home') : tr(`nav.${k === 'privacy' ? 'privacy' : k}` as any),
    u: ROUTES[k][lang],
  })),
  alt: alternates[lang === 'tr' ? 'en' : 'tr'],
};
const themeColor = { light: '#f3f1ec', dark: '#0f0f0e' };
---

<!doctype html>
<html lang={lang} data-sheet={sheet}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="tr" href={new URL(alternates.tr, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.tr, SITE.url).href} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${tr('nav.journal')}`} href={lang === 'tr' ? '/rss.xml' : '/en/rss.xml'} />

    <!-- Tema: ilk boyamadan önce uygula (yanıp sönmeyi önler) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('demirce-theme');
          if (t === 'light' || t === 'dark' || t === 'blueprint') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="preload" href={sairaWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sairaExtWoff} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_GB' : 'tr_TR'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...ld })} />)}

    <!-- Speculation Rules API: bağlantıların üzerine gelindiğinde anında açılan sayfalar -->
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          { "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }, { "not": { "selector_matches": "[data-no-prerender]" } }] }, "eagerness": "moderate" }
        ]
      }
    </script>
    {accent && <style set:html={`:root{--page-accent:${accent}}`} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#icerik">{tr('nav.skip')}</a>
    <div class="grid-guides" aria-hidden="true">
      <div class="wrap">{Array.from({ length: 12 }).map(() => <span />)}</div>
    </div>
    <Header lang={lang} alternates={alternates} />
    <main id="icerik" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} sheet={sheet} title={title} />
    <CommandPalette lang={lang} />
    <div class="toast-region" role="status" aria-live="polite" data-toasts></div>
    <script type="application/json" id="search-data" set:html={JSON.stringify(searchData)} />
    <script>
      import '~/scripts/global';
    </script>
  </body>
</html>
