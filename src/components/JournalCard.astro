---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { postUrl, formatDate, type Lang } from '~/i18n/ui';
import { brandSafe } from '~/lib/text';

interface Props {
  post: CollectionEntry<'journal'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const slug = post.id.split('/')[1];
const d = post.data.date;
---

<article class="jcard">
  <a href={postUrl(slug, lang)}>
    <div class="jmedia">
      {
        post.data.cover ? (
          <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[400, 640, 900]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
        ) : (
          <div class="jtype" aria-hidden="true">
            <span class="display">{String(d.getDate()).padStart(2, '0')}.{String(d.getMonth() + 1).padStart(2, '0')}</span>
            <span class="display">{d.getFullYear()}</span>
          </div>
        )
      }
    </div>
    <div class="jmeta">
      <time class="label muted" datetime={d.toISOString()}>{formatDate(d, lang)}</time>
      <h3 set:html={brandSafe(post.data.title, lang)} />
      <p>{post.data.description}</p>
    </div>
  </a>
</article>

<style>
  .jcard a {
    display: grid;
    gap: 14px;
    text-decoration: none;
  }
  .jmedia {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--line);
  }
  .jmedia :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .jcard a:hover :global(img) {
    transform: scale(1.04);
  }
  .jtype {
    height: 100%;
    display: grid;
    align-content: end;
    padding: 20px;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 24px 24px;
  }
  .jtype .display {
    font-size: var(--step-4);
    line-height: 0.85;
  }
  .jtype .display + .display {
    color: var(--accent-text);
  }
  .jmeta {
    display: grid;
    gap: 8px;
  }
  h3 {
    font-size: var(--step-1);
    text-transform: uppercase;
    line-height: 1.1;
  }
  .jcard a:hover h3 {
    color: var(--accent-text);
  }
  p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
