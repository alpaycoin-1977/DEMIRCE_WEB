---
import { timeline } from '~/data/timeline';
import { projectUrl, postUrl, type Lang } from '~/i18n/ui';
import { brandSafe } from '~/lib/text';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const kindLabel = {
  award: lang === 'tr' ? 'Ödül' : 'Award',
  build: lang === 'tr' ? 'Şantiye' : 'On site',
  event: lang === 'tr' ? 'Etkinlik' : 'Event',
  press: lang === 'tr' ? 'Söyleşi' : 'Talk',
  studio: lang === 'tr' ? 'Ofis' : 'Studio',
};
---

<div class="tl" tabindex="0" role="region" aria-label={lang === 'tr' ? 'Zaman çizelgesi (yatay kaydırılabilir)' : 'Timeline (scrolls horizontally)'}>
  <ol>
    {
      timeline.map((m) => {
        const href = m.href?.project ? projectUrl(m.href.project, lang) : m.href?.post ? postUrl(m.href.post, lang) : undefined;
        return (
          <li class={`tl-item tl-${m.kind}`}>
            <span class="tl-year display">{m.year}</span>
            <span class="tl-tick" aria-hidden="true" />
            <span class="label muted">{m.kind && kindLabel[m.kind]}</span>
            <h3>{href ? <a href={href} set:html={brandSafe(m.title[lang], lang)} /> : <span set:html={brandSafe(m.title[lang], lang)} />}</h3>
            {m.text && <p>{m.text[lang]}</p>}
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .tl {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    padding-bottom: 12px;
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }
  ol {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 300px);
    list-style: none;
    margin: 0;
    padding: 0 64px 0 0;
    position: relative;
  }
  ol::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--step-4) + 18px);
    border-top: 1px solid var(--line-strong);
  }
  .tl-item {
    scroll-snap-align: start;
    padding-right: 28px;
    position: relative;
  }
  .tl-year {
    display: block;
    font-size: var(--step-4);
    color: var(--ink);
  }
  .tl-award .tl-year {
    color: var(--accent-text);
  }
  .tl-tick {
    display: block;
    width: 9px;
    height: 9px;
    margin: 13px 0 16px;
    background: var(--paper);
    border: 1px solid var(--ink);
    transform: rotate(45deg);
    position: relative;
    z-index: 1;
  }
  .tl-award .tl-tick {
    background: var(--accent);
    border-color: var(--accent);
  }
  h3 {
    margin: 8px 0;
    font-size: var(--step-1);
    text-transform: uppercase;
    line-height: 1.1;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent-text);
  }
  p {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
</style>
