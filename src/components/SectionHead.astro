---
import Icon from './Icon.astro';
interface Props {
  index?: string;
  label: string;
  title: string;
  href?: string;
  linkText?: string;
  id?: string;
}
const { index, label, title, href, linkText, id } = Astro.props;
---

<header class="section-head">
  <div>
    <span class="label">{index && <span class="accent">{index} — </span>}{label}</span>
    <h2 id={id}>{title}</h2>
  </div>
  {href && <a class="link-arrow" href={href}>{linkText} <Icon name="arrow-right" size={16} /></a>}
</header>
