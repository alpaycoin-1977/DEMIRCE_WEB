---
import Icon from './Icon.astro';
import { t, type Lang } from '~/i18n/ui';
interface Props {
  lang: Lang;
}
const tr = t(Astro.props.lang);
---

<dialog class="lb" data-lightbox aria-label={tr('common.viewProject')}>
  <figure class="lb-fig">
    <img alt="" data-lb-img class="no-blueprint" />
    <figcaption class="mono" data-lb-cap></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-close" data-lb-close aria-label={tr('nav.close')}><Icon name="close" /></button>
  <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={tr('common.prev')}><Icon name="arrow-left" /></button>
  <button type="button" class="lb-btn lb-next" data-lb-next aria-label={tr('common.next')}><Icon name="arrow-right" /></button>
</dialog>

<style>
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 8 8 / 0.96);
    color: #f3f1ec;
    overscroll-behavior: contain;
  }
  .lb[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.3s var(--ease-out);
  }
  .lb::backdrop {
    background: transparent;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-fig {
    margin: 0;
    display: grid;
    gap: 12px;
    justify-items: center;
    max-width: calc(100vw - 140px);
  }
  .lb-fig img {
    max-width: 100%;
    max-height: calc(100dvh - 110px);
    width: auto;
    height: auto;
    object-fit: contain;
    touch-action: pan-y;
    user-select: none;
  }
  .lb-fig figcaption {
    font-size: var(--step--1);
    opacity: 0.75;
  }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgb(243 241 236 / 0.3);
    background: rgb(20 20 20 / 0.6);
    color: inherit;
    border-radius: 50%;
  }
  .lb-btn:hover {
    background: #e42382;
    border-color: #e42382;
  }
  .lb-close {
    top: 16px;
    right: 16px;
  }
  .lb-prev {
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
  }
  @media (max-width: 700px) {
    .lb-fig {
      max-width: 100vw;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 16px;
      transform: none;
    }
  }
</style>

<script>
  import { toggleBoard, getBoard, BOARD_EVENT } from '~/scripts/board';
  import { toast } from '~/scripts/ui';

  const lb = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
    let items: HTMLButtonElement[] = [];
    let idx = 0;
    const show = (i: number) => {
      idx = (i + items.length) % items.length;
      const b = items[idx];
      img.srcset = b.dataset.srcset || '';
      img.sizes = '100vw';
      img.src = b.dataset.full || '';
      img.alt = b.querySelector('img')?.alt || '';
      cap.textContent = `${idx + 1} / ${items.length}`;
    };
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
      const btns = [...g.querySelectorAll<HTMLButtonElement>('[data-lb-index]')];
      btns.forEach((b, i) =>
        b.addEventListener('click', () => {
          items = btns;
          show(i);
          lb.showModal();
        }),
      );
    });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    lb.addEventListener('click', (e) => {
      if (e.target === lb) lb.close();
    });
    // Kaydırma (swipe)
    let x0: number | null = null;
    img.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    img.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }

  // İlham panosu kalpleri
  const hearts = [...document.querySelectorAll<HTMLButtonElement>('[data-board-id]')];
  const sync = () => {
    const b = getBoard();
    hearts.forEach((h) => {
      const on = b.includes(h.dataset.boardId!);
      h.setAttribute('aria-pressed', String(on));
      h.setAttribute('aria-label', on ? h.dataset.lRemove! : h.dataset.lAdd!);
    });
  };
  hearts.forEach((h) =>
    h.addEventListener('click', () => {
      const added = toggleBoard(h.dataset.boardId!);
      const lang = document.documentElement.lang;
      toast(added ? (lang === 'en' ? 'Added to your mood board ♥' : 'İlham panonuza eklendi ♥') : lang === 'en' ? 'Removed from board' : 'Panodan çıkarıldı');
    }),
  );
  sync();
  addEventListener(BOARD_EVENT, sync);
</script>
