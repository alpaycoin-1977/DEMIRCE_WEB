---
/**
 * İç sayfa başlığı: numaralı etiket satırı, büyük dar başlık ve
 * sayfanın kendi arazisi (sayfa adından türeyen topoğrafya).
 */
import type { ImageMetadata } from 'astro';
import Land from '~/components/Land.astro';

interface Props {
  n: string;
  label: string;
  note?: string;
  title: string;
  lead?: string;
  seed: string;
  photo?: ImageMetadata;
  alt?: string;
  /** Arazinin mürekkep eşiği */
  threshold?: number;
  hair?: number;
}
const { n, label, note, title, lead, seed, photo, alt, threshold = 0.56, hair } = Astro.props;
---

<header class="ph wrap">
  <p class="sec-head" aria-hidden="true"><span class="n">{n}</span><b>{label}</b><span class="fill"></span><span class="note">{note}</span></p>
  <div class="ph-grid">
    <div class="ph-text">
      <h1 class="ph-title">{title}</h1>
      {lead && <p class="ph-lead">{lead}</p>}
      <slot />
    </div>
    <Land seed={seed} photo={photo} alt={alt} class="ph-land" threshold={threshold} hair={hair} levels={30} />
  </div>
</header>

<style>
  .ph {
    padding-block: clamp(28px, 3.4vw, 48px) clamp(56px, 7vw, 104px);
  }
  .sec-head {
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 96px);
    align-items: end;
  }
  .ph-title {
    font-size: var(--t-mega);
    line-height: 0.84;
    letter-spacing: -0.005em;
    margin: 0 0 clamp(24px, 3vw, 40px);
  }
  .ph-lead {
    font-size: var(--t-l);
    line-height: 1.38;
    letter-spacing: -0.01em;
    font-weight: 380;
    color: var(--ink-2);
    max-width: 30em;
    margin: 0;
  }
  .ph-grid :global(.ph-land) {
    aspect-ratio: 4 / 3;
    width: 100%;
  }
  @media (max-width: 860px) {
    .ph-grid {
      grid-template-columns: 1fr;
    }
    .ph-grid :global(.ph-land) {
      aspect-ratio: 16 / 9;
      order: -1;
    }
  }
</style>
