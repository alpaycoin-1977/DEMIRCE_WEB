---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '~/data/projects';
import { placeLabel } from '~/data/projects';
import { projectCover } from '~/lib/images';
import { projectUrl, t, type Lang } from '~/i18n/ui';
import { brandSafe } from '~/lib/text';

interface Props {
  project: Project;
  lang: Lang;
  index?: number;
  size?: 'l' | 'm' | 's';
  eager?: boolean;
  sizes?: string;
}
const { project: p, lang, index, size = 'm', eager = false, sizes } = Astro.props;
const tr = t(lang);
const cover = projectCover(p.slug);
const cats = p.categories.slice(0, 3).map((c) => tr(`cat.${c}` as const));
---

<article class={`pcard pcard--${size}`} style={`--pc:${p.color}`} data-cats={p.categories.join(' ')}>
  <a href={projectUrl(p.slug, lang)} class="pcard-link">
    <div class="pcard-media">
      <Image
        src={cover}
        alt={p.title[lang]}
        widths={[480, 720, 1080, 1600]}
        sizes={sizes ?? (size === 'l' ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw')}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        style={`view-transition-name: p-${p.slug}`}
      />
      <span class="pcard-band" aria-hidden="true"><span class="label">{tr('common.viewProject')}</span><Icon name="arrow-up-right" size={18} /></span>
      {p.award && <span class="pcard-award label">★ {p.award[lang]}</span>}
    </div>
    <div class="pcard-meta">
      <span class="label muted">
        {index !== undefined && <span class="pcard-idx">{String(index).padStart(2, '0')}</span>}
        {cats.join(' · ')}
      </span>
      <h3 set:html={brandSafe(p.title[lang], lang)} />
      {(p.city || p.year) && <span class="label muted">{[p.city && placeLabel(p, lang), p.year].filter(Boolean).join(' · ')}</span>}
    </div>
  </a>
</article>

<style>
  .pcard-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .pcard-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--paper-2);
  }
  .pcard--l .pcard-media {
    aspect-ratio: 16 / 9.5;
  }
  .pcard--s .pcard-media {
    aspect-ratio: 4 / 3;
  }
  .pcard-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease-out),
      filter 0.4s;
  }
  .pcard-link:hover .pcard-media :global(img),
  .pcard-link:focus-visible .pcard-media :global(img) {
    transform: scale(1.035);
  }
  .pcard-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    background: var(--pc);
    color: #fff;
    transform: translateY(101%);
    transition: transform 0.45s var(--ease-out);
  }
  .pcard-link:hover .pcard-band,
  .pcard-link:focus-visible .pcard-band {
    transform: none;
  }
  .pcard-award {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 9px;
    background: var(--paper);
    color: var(--ink);
  }
  .pcard-meta {
    display: grid;
    gap: 6px;
    padding-top: 14px;
  }
  .pcard-meta h3 {
    font-size: var(--step-2);
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .pcard--l .pcard-meta h3 {
    font-size: var(--step-3);
  }
  .pcard-link:hover h3 {
    color: var(--accent-text);
  }
  .pcard-idx {
    display: inline-block;
    margin-right: 10px;
    padding-right: 10px;
    border-right: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .pcard-meta .label:first-child::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background: var(--pc);
    vertical-align: 0;
  }
</style>
