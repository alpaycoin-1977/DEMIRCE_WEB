---
/**
 * CEPHE KOMPOZİSYONU — altın dikdörtgen bölünmesinden doğan, sayfa adına
 * göre her seferinde aynı çıkan siyah / taranmış / boş dikdörtgenler.
 */
import { composition, goldenSubdivision, PHI, hash } from '~/lib/geometry';
interface Props {
  seed: string;
  /** en / boy oranı (varsayılan φ) */
  ratio?: number;
  levels?: number;
  dense?: number;
  spiral?: boolean;
  class?: string;
  label?: string;
}
const { seed, ratio = PHI, levels = 7, dense = 0.55, spiral = true, class: cls = '', label } = Astro.props;
const H = 1000;
const W = Math.round(H * ratio);
const cells = composition(seed, W, H, levels, dense);
const g = goldenSubdivision(W, H, levels + 3);
const id = `h${hash(seed).toString(36)}`;
const gap = 7;
const r = (n: number) => Math.round(n * 10) / 10;
---

<svg class={`facade ${cls}`} viewBox={`0 0 ${W} ${H}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <defs>
    <pattern id={`${id}v`} width="9" height="9" patternUnits="userSpaceOnUse"><path d="M2 0v9" stroke="var(--ink)" stroke-width="1.6" /></pattern>
    <pattern id={`${id}h`} width="9" height="9" patternUnits="userSpaceOnUse"><path d="M0 2h9" stroke="var(--ink)" stroke-width="1.6" /></pattern>
  </defs>
  {
    cells.map((c) => {
      const x = r(c.x + gap / 2);
      const y = r(c.y + gap / 2);
      const w = r(Math.max(0, c.w - gap));
      const h = r(Math.max(0, c.h - gap));
      if (c.fill === 'void') return null;
      if (c.fill === 'line') return <rect x={x} y={y} width={w} height={h} fill="none" stroke="var(--ink)" stroke-width="1.5" />;
      const fill = c.fill === 'black' ? 'var(--ink)' : c.fill === 'grey' ? 'var(--fac-grey)' : `url(#${id}${c.fill === 'hatch-v' ? 'v' : 'h'})`;
      return <rect x={x} y={y} width={w} height={h} fill={fill} />;
    })
  }
  {spiral && <path class="fac-arc" d={g.spiral} fill="none" stroke="var(--fac-line)" stroke-width="1.4" />}
</svg>
