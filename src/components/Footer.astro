---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '~/data/site';
import { ROUTES, t, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
  sheet: string;
  title?: string;
}
const { lang, sheet, title } = Astro.props;
const tr = t(lang);
const today = new Date().toLocaleDateString(lang === 'tr' ? 'tr-TR' : 'en-GB', { year: 'numeric', month: '2-digit', day: '2-digit' });
const years = new Date().getFullYear() - SITE.founded;
const links = [
  ['projects', tr('nav.projects')],
  ['office', tr('nav.office')],
  ['services', tr('nav.services')],
  ['journal', tr('nav.journal')],
  ['feasibility', tr('nav.feasibility')],
  ['board', tr('nav.board')],
  ['contact', tr('nav.contact')],
  ['privacy', tr('nav.privacy')],
] as const;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cta-row">
      <p class="display cta-title">
        {lang === 'tr' ? 'Bir sonraki mekânı' : "Let's draw the next"}<br />
        <span class="accent">{lang === 'tr' ? 'birlikte çizelim.' : 'space together.'}</span>
      </p>
      <div class="cta-actions">
        <a class="btn btn--accent" href={ROUTES.feasibility[lang]}>{tr('nav.start')} <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost btn--plain" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>

    <div class="cols">
      <div class="col">
        <h2 class="label muted">{tr('footer.office')}</h2>
        <address>
          {SITE.address.street}<br />
          {SITE.address.district} / {SITE.address.city}<br />
          {SITE.address.countryName[lang]}
        </address>
        <a class="map-link link-arrow" href={SITE.mapsUrl} target="_blank" rel="noopener">{lang === 'tr' ? 'Yol tarifi' : 'Directions'} <Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div class="col">
        <h2 class="label muted">{tr('nav.contact')}</h2>
        <p><a href={SITE.phoneHref}>{SITE.phone}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <h2 class="label muted">{tr('footer.follow')}</h2>
        <ul class="social">
          <li><a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a></li>
          <li><a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>
          <li><a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a></li>
        </ul>
      </div>
      <nav class="col" aria-label={lang === 'tr' ? 'Alt menü' : 'Footer navigation'}>
        <h2 class="label muted">{lang === 'tr' ? 'Site' : 'Site'}</h2>
        <ul class="links">
          {links.map(([k, label]) => <li><a href={ROUTES[k][lang]}>{label}</a></li>)}
        </ul>
      </nav>
    </div>

    <!-- Antet (title block) — mimari paftalardaki gibi -->
    <dl class="title-block" aria-label={lang === 'tr' ? 'Pafta anteti' : 'Sheet title block'}>
      <div class="tb-cell tb-wide"><dt>{tr('footer.project')}</dt><dd>{SITE.name}{title ? ` — ${title}` : ''}</dd></div>
      <div class="tb-cell"><dt>{tr('footer.sheet')}</dt><dd>{sheet}</dd></div>
      <div class="tb-cell"><dt>{tr('footer.scale')}</dt><dd>1/1</dd></div>
      <div class="tb-cell"><dt>{tr('footer.date')}</dt><dd>{today}</dd></div>
      <div class="tb-cell"><dt>{tr('footer.coords')}</dt><dd>38.43°{lang === 'tr' ? 'K' : 'N'} 27.14°{lang === 'tr' ? 'D' : 'E'}</dd></div>
      <div class="tb-cell"><dt>{tr('footer.drawn')}</dt><dd>DEMİRCE · {years}{lang === 'tr' ? ' yıl' : ' yrs'}</dd></div>
    </dl>

    <div class="big-logo" aria-hidden="true"><Logo variant="wordmark" /></div>

    <div class="legal">
      <span class="mono muted">© {new Date().getFullYear()} {SITE.name}. {tr('footer.rights')}</span>
      <a href="#icerik" class="mono back-top">{tr('footer.top')} ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(48px, 8vw, 120px);
    border-top: 1px solid var(--line);
    padding-top: clamp(48px, 7vw, 96px);
    background: var(--paper);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .cta-title {
    font-size: var(--step-4);
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-block: 40px;
    border-top: 1px solid var(--line);
  }
  .col h2 {
    margin-bottom: 12px;
  }
  .col h2 + * {
    margin-bottom: 20px;
  }
  address {
    font-style: normal;
    margin-bottom: 16px;
    color: var(--ink-2);
  }
  .col a {
    text-decoration: none;
  }
  .col p a:hover,
  .links a:hover {
    color: var(--accent-text);
  }
  .social {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0 0 0 -10px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }
  .social a:hover {
    color: var(--accent-text);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    column-gap: 24px;
  }
  .links li {
    padding: 3px 0;
  }
  .title-block {
    display: grid;
    grid-template-columns: 2.2fr repeat(5, 1fr);
    margin: 0;
    border: 1px solid var(--line-strong);
  }
  .tb-cell {
    padding: 10px 12px;
    border-left: 1px solid var(--line-strong);
    min-width: 0;
  }
  .tb-cell:first-child {
    border-left: 0;
  }
  .tb-cell dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tb-cell dd {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .big-logo {
    padding-block: clamp(24px, 4vw, 48px) 12px;
    color: var(--ink);
  }
  .big-logo :global(.logo) {
    width: 100%;
    height: auto;
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 16px 28px;
    border-top: 1px solid var(--line);
  }
  .back-top {
    text-decoration: none;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .title-block {
      grid-template-columns: 1fr 1fr;
    }
    .tb-cell {
      border-left: 0;
      border-top: 1px solid var(--line-strong);
    }
    .tb-cell:nth-child(even) {
      border-left: 1px solid var(--line-strong);
    }
    .tb-wide {
      grid-column: 1 / -1;
      border-top: 0;
    }
    .tb-wide + .tb-cell {
      border-left: 0;
    }
    .tb-wide ~ .tb-cell:nth-child(odd) {
      border-left: 1px solid var(--line-strong);
    }
    .tb-wide ~ .tb-cell:nth-child(even) {
      border-left: 0;
    }
  }
  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
