---
/** Ölçekler: 1:20 detaydan 1:5000 kent adasına — birikimi sayı vermeden anlatır */
import { Image } from 'astro:assets';
import { scales } from '~/data/monograph';
import { getProject } from '~/data/projects';
import { projectImages } from '~/lib/images';
import { projectUrl, type Lang } from '~/i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="scales">
  <div class="bar" aria-hidden="true">{scales.map(() => <span />)}</div>
  <ol>
    {
      scales.map((s) => {
        const p = getProject(s.slug)!;
        return (
          <li class="rise">
            <a href={projectUrl(s.slug, lang)}>
              <span class="ratio">{s.ratio}</span>
              <span class="small sname">{s.name[lang]}</span>
              <Image src={projectImages(s.slug)[s.image]} alt={p.title[lang]} widths={[320, 560]} sizes="(min-width: 900px) 16vw, 45vw" loading="lazy" />
              <span class="note">{s.note[lang]}</span>
              <span class="small muted">{p.title[lang]}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .bar {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    height: 10px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 18px;
  }
  .bar span {
    border-left: 1px solid var(--ink);
  }
  .bar span:nth-child(odd) {
    background: var(--ink);
    height: 4px;
    align-self: end;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 24px);
  }
  a {
    display: grid;
    gap: 10px;
    text-decoration: none;
  }
  .ratio {
    font-family: var(--display);
    font-stretch: 68%;
    font-weight: 540;
    font-size: clamp(2.2rem, 1.4rem + 2.4vw, 3.6rem);
    line-height: 0.9;
    font-variant-numeric: lining-nums;
  }
  .sname {
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  a :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .note {
    font-size: var(--t-s);
    line-height: 1.45;
    color: var(--ink-2);
  }
  @media (max-width: 1000px) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 40px;
    }
    .bar {
      display: none;
    }
  }
  @media (max-width: 560px) {
    ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
