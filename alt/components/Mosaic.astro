---
/**
 * KESİTLER — kontakt sayfası.
 * Tüm projelerin görsellerinden küçük, isimsiz kesitler. Proje saymadan
 * bir birikimi hissettirir. Üzerine gelindiğinde altyazıda proje adı görünür.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projects } from '~/data/projects';
import { projectImages } from '~/lib/images';
import { projectUrl, type Lang } from '~/i18n/ui';

interface Props {
  lang: Lang;
  count?: number;
}
const { lang, count = 132 } = Astro.props;
// Projeler arasında dönüşümlü sırala, sonra sabit tohumla karıştır (her derlemede aynı düzen)
const pools = projects.map((p) => projectImages(p.slug).map((img, i) => ({ p, img, i })));
const order: { p: (typeof projects)[number]; img: ImageMetadata; i: number }[] = [];
for (let r = 0; order.length < count && r < 40; r++) for (const pool of pools) if (pool[r] && order.length < count) order.push(pool[r]);
let seed = 1999;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
for (let k = order.length - 1; k > 0; k--) {
  const j = Math.floor(rnd() * (k + 1));
  [order[k], order[j]] = [order[j], order[k]];
}
const tiles = await Promise.all(
  order.map(async (o) => ({
    src: (await getImage({ src: o.img, width: 220, height: 220, fit: 'cover', format: 'webp', quality: 58 })).src,
    t: o.p.title[lang],
    u: projectUrl(o.p.slug, lang),
  })),
);
---

<div class="mosaic" data-mosaic>
  <div class="tiles" aria-hidden="true">
    {
      tiles.map((t) => (
        <a href={t.u} tabindex="-1" data-t={t.t}>
          <img src={t.src} alt="" width="220" height="220" loading="lazy" decoding="async" />
        </a>
      ))
    }
  </div>
  <p class="small muted cap" data-cap aria-hidden="true">&nbsp;</p>
</div>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 4px;
  }
  .tiles a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--paper-2);
  }
  .tiles img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.88;
    transition:
      filter 0.5s var(--ease),
      opacity 0.5s var(--ease);
  }
  .tiles a:hover img,
  .tiles a.is-sib img {
    filter: none;
    opacity: 1;
  }
  .cap {
    min-height: 1.5em;
    margin-top: 12px;
  }
  @media (max-width: 1000px) {
    .tiles {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .tiles a:nth-child(n + 97) {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .tiles {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 3px;
    }
    .tiles a:nth-child(n + 61) {
      display: none;
    }
  }
</style>

<script>
  // Üzerine gelinen kesitin projesindeki tüm kesitleri renklendir
  document.querySelectorAll<HTMLElement>('[data-mosaic]').forEach((m) => {
    const cap = m.querySelector<HTMLElement>('[data-cap]')!;
    const links = [...m.querySelectorAll<HTMLAnchorElement>('a[data-t]')];
    links.forEach((a) => {
      a.addEventListener('mouseenter', () => {
        cap.textContent = a.dataset.t!;
        links.forEach((l) => l.classList.toggle('is-sib', l.dataset.t === a.dataset.t));
      });
    });
    m.addEventListener('mouseleave', () => {
      cap.innerHTML = '&nbsp;';
      links.forEach((l) => l.classList.remove('is-sib'));
    });
  });
</script>
