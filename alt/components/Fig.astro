---
import { Image } from 'astro:assets';
import type { Figure } from '@alt/data/cases';
import { resolveRef } from '@alt/data/refs';
import type { Lang } from '~/i18n/ui';

interface Props {
  fig: Figure;
  slug: string;
  lang: Lang;
  n: number;
  alt: string;
}
const { fig, slug, lang, n, alt } = Astro.props;
const imgs = fig.refs.map((r) => resolveRef(r, slug)).filter(Boolean);
// Düşük çözünürlüklü görselleri büyütüp bulanıklaştırma: düzeni otomatik daralt
const minW = Math.min(...imgs.map((i) => i.width));
const layout = fig.layout === 'full' && minW < 1400 ? 'wide' : fig.layout;
const narrow = (layout === 'wide' || layout === 'strip') && minW < 1000;
const sizes = {
  full: '100vw',
  wide: '(min-width: 1200px) 1100px, 100vw',
  pair: '(min-width: 800px) 48vw, 100vw',
  grid: '(min-width: 800px) 32vw, 50vw',
  strip: '(min-width: 1200px) 1100px, 100vw',
  inset: '(min-width: 800px) 40vw, 100vw',
}[layout];
const label = lang === 'tr' ? 'Şekil' : 'Fig.';
---

<figure class={`fig fig--${layout} fig--n${imgs.length} ${narrow ? 'fig--narrow' : ''} rise`}>
  <div class="fig-imgs">
    {
      imgs.map((img) => (
        <Image
          src={img}
          alt={alt}
          widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= img.width).concat(img.width < 480 ? [img.width] : [])}
          sizes={sizes}
          loading="lazy"
        />
      ))
    }
  </div>
  <figcaption><span class="fig-n">{label} {n}</span>{fig.caption?.[lang]}</figcaption>
</figure>

<style>
  .fig {
    margin-block: clamp(32px, 5vw, 72px);
  }
  .fig-imgs {
    display: grid;
    gap: clamp(8px, 1.2vw, 18px);
  }
  .fig-imgs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--paper-2);
  }
  .fig--full {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .fig--full figcaption {
    padding-inline: var(--gutter);
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .fig--full .fig-imgs :global(img) {
    max-height: 92vh;
  }
  .fig--wide {
    max-width: 1100px;
  }
  .fig--pair .fig-imgs {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }
  .fig--pair .fig-imgs :global(img) {
    aspect-ratio: 4 / 3;
  }
  .fig--narrow {
    max-width: 820px;
  }
  .fig--grid .fig-imgs {
    grid-template-columns: repeat(3, 1fr);
  }
  .fig--grid.fig--n4 .fig-imgs {
    grid-template-columns: repeat(4, 1fr);
  }
  .fig--grid .fig-imgs :global(img) {
    aspect-ratio: 1;
  }
  .fig--strip .fig-imgs :global(img) {
    object-fit: contain;
    background: #fff;
  }
  .fig--inset {
    max-width: 560px;
    margin-left: auto;
  }
  @media (max-width: 700px) {
    .fig--grid .fig-imgs,
    .fig--grid.fig--n4 .fig-imgs {
      grid-template-columns: 1fr 1fr;
    }
    .fig--pair .fig-imgs {
      grid-template-columns: 1fr;
    }
    .fig--pair .fig-imgs :global(img) {
      aspect-ratio: auto;
    }
  }
</style>
